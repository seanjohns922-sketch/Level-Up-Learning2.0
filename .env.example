# Copy to .env.local. Supply an approved test project's URL and PUBLIC key.
# Blank values deliberately fail closed. Do not paste production credentials.
NEXT_PUBLIC_APP_ENV=staging
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Local origin used for application links. Restart dev after changing settings.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: synthetic/local voice assets. Omit to use existing public voice clips.
# NEXT_PUBLIC_VOICE_CLIP_BASE=http://127.0.0.1:56521/storage/v1/object/public/voice/miranda

# Never put service-role keys, database passwords, SMTP credentials or Resend
# API keys in NEXT_PUBLIC_* variables. All NEXT_PUBLIC_* values reach the browser.
