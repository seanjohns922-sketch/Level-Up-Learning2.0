{
  "1:1": { "idea": "Tenths are 1 whole split into 10 equal parts. 0.1 means one tenth.", "example": "7 of 10 parts shaded → 7/10 = 0.7", "steps": ["Count the equal parts in the whole: 10.", "Count the shaded parts: 7.", "7 tenths is written 7/10 or 0.7."], "tip": "The first digit after the point is tenths.", "visual": {"kind": "scene", "rows": [[{"type": "fraction", "shape": "bar", "parts": 10, "shaded": 7, "shadeStep": 2, "focus": [1, 2]}], [{"type": "text", "text": "7/10 = 0.7", "big": true, "tone": "answer", "step": 3, "focus": [3]}]]} },
  "1:2": { "idea": "Hundredths are 1 whole split into 100 equal parts. 0.01 is one hundredth.", "example": "13 of 100 squares shaded → 0.13", "steps": ["The grid has 100 equal squares.", "13 are shaded, which is 13 hundredths.", "13 hundredths is written 0.13."], "tip": "0.13 has 1 tenth and 3 hundredths.", "visual": {"kind": "scene", "rows": [[{"type": "fraction", "shape": "square", "parts": 100, "shaded": 13, "shadeStep": 2, "focus": [1, 2]}], [{"type": "text", "text": "13 hundredths = 0.13", "big": true, "tone": "answer", "step": 3, "focus": [3]}]]} },
  "1:3": { "idea": "A place value chart shows each decimal digit's value.", "example": "1 one, 7 tenths, 3 hundredths → 1.73", "steps": ["Write the ones digit before the point: 1.", "Write tenths then hundredths after the point: 7, then 3.", "The number is 1.73."], "tip": "Use 0 for an empty place: 1 one and 3 hundredths is 1.03.", "visual": {"kind": "scene", "rows": [[{"type": "chips", "items": ["Ones: 1", "Tenths: 7", "Hundredths: 3"], "focus": [1, 2]}], [{"type": "text", "text": "1.73", "big": true, "tone": "answer", "step": 3, "focus": [3]}]]} },
  "2:1": { "idea": "Compare decimals from the left: ones, then tenths, then hundredths.", "example": "2.79 or 5.2 → 5.2 is greater", "steps": ["Compare the ones first: 2 and 5.", "5 ones is more than 2 ones.", "So 5.2 is greater, even though 2.79 has more digits."], "tip": "More digits does not mean bigger.", "visual": {"kind": "scene", "rows": [[{"type": "line", "min": 0, "max": 6, "tick": 0.5, "labelEvery": 1, "marks": [{"value": 2.79, "text": "2.79"}, {"value": 5.2, "text": "5.2", "tone": "answer", "step": 3}], "focus": [1, 2, 3]}], [{"type": "text", "text": "5.2 is greater", "big": true, "tone": "answer", "step": 3, "focus": [3]}]]} },
  "2:2": { "idea": "To order decimals, give them the same number of places, then compare.", "example": "1.6, 1.09, 1.7 → 1.09, 1.6, 1.7", "steps": ["Write them all to hundredths: 1.60, 1.09, 1.70.", "The ones are the same, so compare tenths: 0, 6 and 7.", "Smallest to largest: 1.09, 1.6, 1.7."], "tip": "Adding a 0 at the end of a decimal does not change its value.", "visual": {"kind": "scene", "rows": [[{"type": "chips", "items": ["1.60", "1.09", "1.70"], "focus": [1]}], [{"type": "line", "min": 1, "max": 1.8, "tick": 0.1, "labelEvery": 0.2, "marks": [{"value": 1.09, "text": "1.09", "step": 2}, {"value": 1.6, "text": "1.6", "step": 2}, {"value": 1.7, "text": "1.7", "step": 2}], "focus": [2]}], [{"type": "text", "text": "1.09, 1.6, 1.7", "big": true, "tone": "answer", "step": 3, "focus": [3]}]]} },
  "2:3": { "idea": "Each small mark on a 0 to 1 line can stand for a tenth.", "example": "0.3 → third mark after 0", "steps": ["Count the spaces between 0 and 1: 10.", "Each space is one tenth.", "Count 3 spaces from 0 to reach 0.3."], "tip": "Check what each mark is worth before you count.", "visual": {"kind": "scene", "rows": [[{"type": "line", "min": 0, "max": 1, "tick": 0.1, "labelEvery": 0.5, "jumps": [{"from": 0, "to": 0.1, "step": 2}, {"from": 0.1, "to": 0.2, "step": 2}, {"from": 0.2, "to": 0.3, "step": 2}], "marks": [{"value": 0.3, "text": "0.3", "tone": "answer", "step": 3}], "focus": [1, 2, 3]}]]} },
  "3:1": { "idea": "Any whole number is odd or even by its ones digit.", "example": "8,694 → even; 5,079 → odd", "steps": ["Look only at the ones digit.", "8,694 ends in 4, an even digit.", "5,079 ends in 9, an odd digit."], "tip": "Big numbers follow the same rule as small ones.", "visual": {"kind": "scene", "rows": [[{"type": "chips", "items": ["8,694 ends in 4", "5,079 ends in 9"], "focus": [1]}], [{"type": "chips", "items": ["4 is even → 8,694 even", "9 is odd → 5,079 odd"], "step": 2, "focus": [2, 3]}]]} },
  "3:2": { "idea": "The parity of a sum follows a rule.", "example": "odd + odd = even; odd + even = odd", "steps": ["Two odd numbers each have 1 left over when paired.", "The two leftovers pair up, so the sum is even.", "An odd and an even leave one leftover, so the sum is odd."], "tip": "You can decide odd or even without working out the sum.", "visual": {"kind": "scene", "rows": [[{"type": "counters", "n": 3, "label": "odd", "cols": 3}, {"type": "sign", "text": "+"}, {"type": "counters", "n": 5, "label": "odd", "cols": 5, "second": 0}], [{"type": "text", "text": "odd + odd = even", "big": true, "tone": "answer", "step": 2, "focus": [2]}], [{"type": "text", "text": "odd + even = odd", "step": 3, "focus": [3]}]]} },
  "3:3": { "idea": "A product is even if either number is even.", "example": "3 × 4 = 12 → even; 3 × 5 = 15 → odd", "steps": ["Multiplying by an even number makes groups that pair up.", "So any product with an even factor is even.", "Only odd × odd gives an odd answer."], "tip": "One even factor is enough to make the product even.", "visual": {"kind": "scene", "rows": [[{"type": "array", "rows": 3, "cols": 4, "label": "3 × 4 = 12, even", "focus": [1, 2]}, {"type": "array", "rows": 3, "cols": 5, "label": "3 × 5 = 15, odd", "focus": [3]}]]} },
  "4:1": { "idea": "Multiplying by 10 moves every digit one place to the left.", "example": "82 × 100 = 8,200", "steps": ["× 100 moves each digit two places left.", "8 tens become 8 thousands; 2 ones become 2 hundreds.", "Fill the empty places with 0: 8,200."], "tip": "× 10, × 100, × 1000 move 1, 2, 3 places.", "visual": {"kind": "scene", "rows": [[{"type": "chips", "items": ["82", "× 100", "8,200"], "arrows": true, "focus": [1, 2, 3]}], [{"type": "chips", "items": ["Th: 8", "H: 2", "T: 0", "O: 0"], "step": 2, "focus": [2, 3]}]]} },
  "4:2": { "idea": "Dividing by 10 moves every digit one place to the right.", "example": "93,100 ÷ 100 = 931", "steps": ["÷ 100 moves each digit two places right.", "9 ten thousands become 9 hundreds.", "The answer is 931."], "tip": "The digits stay the same; only their places change.", "visual": {"kind": "scene", "rows": [[{"type": "chips", "items": ["93,100", "÷ 100", "931"], "arrows": true, "focus": [1, 2, 3]}]]} },
  "4:3": { "idea": "Decide whether multiplying or dividing by a power of 10 makes it bigger or smaller.", "example": "9 × 1000 > 9 × 10", "steps": ["Both multiply 9, so compare what it is multiplied by.", "× 1000 makes it much bigger than × 10.", "9,000 > 90."], "tip": "Multiplying makes bigger; dividing makes smaller.", "visual": {"kind": "scene", "rows": [[{"type": "chips", "items": ["9 × 10 = 90", "9 × 1,000 = 9,000"], "marked": [1], "markStep": 3, "focus": [1, 2]}], [{"type": "text", "text": "9,000 > 90", "big": true, "tone": "answer", "step": 3, "focus": [3]}]]} },
  "5:1": { "idea": "Find a missing digit by working through the written method.", "example": "515 + 1,189 = 17?4 → 1,704, missing 0", "steps": ["Add the ones: 5 + 9 = 14. Write 4, carry 1.", "Tens: 1 + 8 + 1 = 10. Write 0, carry 1.", "The missing tens digit is 0."], "tip": "Work column by column from the ones.", "visual": {"kind": "scene", "rows": [[{"type": "column", "op": "+", "top": "515", "bottom": "1189", "carries": ["1", "1", " "], "carryStep": 2, "answer": "1704", "answerStep": 3, "focus": [1, 2, 3]}]]} },
  "5:2": { "idea": "Split numbers or round to friendly numbers, then adjust.", "example": "5,289 − 16 = 5,289 − 10 − 6 = 5,273", "steps": ["Split 16 into 10 and 6.", "5,289 − 10 = 5,279.", "5,279 − 6 = 5,273."], "tip": "Split the smaller number, not the bigger one.", "visual": {"kind": "scene", "rows": [[{"type": "line", "min": 5270, "max": 5290, "tick": 1, "labelEvery": 5, "jumps": [{"from": 5289, "to": 5279, "text": "−10", "step": 2}, {"from": 5279, "to": 5273, "text": "−6", "step": 3}], "marks": [{"value": 5289, "text": "5,289"}, {"value": 5273, "text": "5,273", "tone": "answer", "step": 3}], "focus": [1, 2, 3]}]]} },
  "5:3": { "idea": "Choose the strategy that suits the numbers.", "example": "268 + 532: ones make 10, tens make 10 → 800", "steps": ["Look at the ones: 8 + 2 makes a ten.", "Tens: 60 + 30 + 10 = 100. Hundreds: 200 + 500 = 700.", "700 + 100 = 800."], "tip": "Look for pairs that make 10 or 100.", "visual": {"kind": "scene", "rows": [[{"type": "blocks", "hundreds": 2, "tens": 6, "ones": 8, "label": "268"}, {"type": "sign", "text": "+"}, {"type": "blocks", "hundreds": 5, "tens": 3, "ones": 2, "label": "532"}], [{"type": "text", "text": "8 + 2 = 10, 60 + 30 + 10 = 100", "step": 2, "focus": [1, 2]}], [{"type": "text", "text": "800", "big": true, "tone": "answer", "step": 3, "focus": [3]}]]} },
  "6:1": { "idea": "Multiply by each place value part, then add.", "example": "18 × 16 = 18 × 10 + 18 × 6 = 180 + 108 = 288", "steps": ["Split 16 into 10 and 6.", "18 × 10 = 180 and 18 × 6 = 108.", "180 + 108 = 288."], "tip": "Check: 18 × 16 is about 20 × 15 = 300.", "visual": {"kind": "scene", "rows": [[{"type": "chips", "items": ["18 × 10 = 180", "18 × 6 = 108"], "focus": [1, 2]}], [{"type": "text", "text": "180 + 108 = 288", "big": true, "tone": "answer", "step": 3, "focus": [3]}]]} },
  "6:2": { "idea": "The box method splits a multiplication into easy parts.", "example": "12 × 13 → 10×10 + 10×3 + 2×10 + 2×3 = 156", "steps": ["Split both: 12 = 10 + 2 and 13 = 10 + 3.", "Multiply each pair: 100, 30, 20 and 6.", "Add the boxes: 100 + 30 + 20 + 6 = 156."], "tip": "Every part of one number multiplies every part of the other.", "visual": {"kind": "scene", "rows": [[{"type": "chips", "items": ["10 × 10 = 100", "10 × 3 = 30", "2 × 10 = 20", "2 × 3 = 6"], "step": 2, "focus": [1, 2]}], [{"type": "text", "text": "100 + 30 + 20 + 6 = 156", "big": true, "tone": "answer", "step": 3, "focus": [3]}]]} },
  "6:3": { "idea": "Use a times table fact to divide.", "example": "56 ÷ 7 → 7 × 8 = 56 → 8", "steps": ["Ask: 7 times what is 56?", "7 × 8 = 56.", "So 56 ÷ 7 = 8."], "tip": "Know your times tables both ways.", "visual": {"kind": "scene", "rows": [[{"type": "groups", "groups": 8, "each": 7, "label": "56 in groups of 7", "focus": [1, 2]}], [{"type": "text", "text": "56 ÷ 7 = 8", "big": true, "tone": "answer", "step": 3, "focus": [3]}]]} },
  "7:1": { "idea": "Round to the place that matters for the estimate.", "example": "38,920 to the nearest 1,000 → 39,000", "steps": ["Find the thousands either side: 38,000 and 39,000.", "Look at the hundreds digit: 9 is 5 or more.", "Round up to 39,000."], "tip": "Look at the digit just to the right of the rounding place.", "visual": {"kind": "scene", "rows": [[{"type": "line", "min": 38000, "max": 39000, "tick": 100, "labelEvery": 500, "marks": [{"value": 38920, "text": "38,920"}, {"value": 39000, "tone": "answer", "step": 3}], "focus": [1, 2, 3]}], [{"type": "text", "text": "39,000", "big": true, "tone": "answer", "step": 3, "focus": [3]}]]} },
  "7:2": { "idea": "Estimate with rounded numbers to check if an answer makes sense.", "example": "398 + 204 = 9,602? Estimate 400 + 200 = 600 → No", "steps": ["Round each number: 400 and 200.", "Estimate: 400 + 200 = 600.", "9,602 is far from 600, so it is wrong."], "tip": "A good estimate tells you roughly how big the answer should be.", "visual": {"kind": "scene", "rows": [[{"type": "text", "text": "398 + 204 = 9,602?", "focus": [1]}], [{"type": "text", "text": "400 + 200 = 600", "step": 2, "focus": [2]}], [{"type": "text", "text": "Far from 600: wrong", "big": true, "tone": "answer", "step": 3, "focus": [3]}]]} },
  "7:3": { "idea": "Round prices to check money calculations.", "example": "Six $19 tickets ≈ 6 × $20 = $120 → reasonable", "steps": ["Round $19 to $20.", "6 × $20 = $120.", "The real cost is a little less, so $120 is a fair estimate."], "tip": "Rounding up gives an estimate a bit higher than the real cost.", "visual": {"kind": "scene", "rows": [[{"type": "money", "items": ["note-20"], "label": "$19 ≈ $20", "focus": [1]}], [{"type": "text", "text": "6 × $20 = $120", "step": 2, "focus": [2]}], [{"type": "text", "text": "$120 is a fair estimate", "big": true, "tone": "answer", "step": 3, "focus": [3]}]]} },
  "8:1": { "idea": "Plan the steps: total cost, then what is left.", "example": "$60; 3 × $4 + 4 × $8 = $44 → $16 left", "steps": ["Cost of each item type: 3 × $4 = $12 and 4 × $8 = $32.", "Total spent: $12 + $32 = $44.", "Money left: $60 − $44 = $16."], "tip": "Write each step down so you don't lose track.", "visual": {"kind": "scene", "rows": [[{"type": "money", "items": ["note-50", "note-10"], "label": "$60", "focus": [3]}], [{"type": "chips", "items": ["3 × $4 = $12", "4 × $8 = $32"], "focus": [1]}], [{"type": "text", "text": "$12 + $32 = $44", "step": 2, "focus": [2]}], [{"type": "text", "text": "$60 − $44 = $16 left", "big": true, "tone": "answer", "step": 3, "focus": [3]}]]} },
  "8:2": { "idea": "Work out the total cost, then the change.", "example": "3 tickets at $12 from $40 → $36, change $4", "steps": ["Total: 3 × $12 = $36.", "Change: $40 − $36.", "The change is $4."], "tip": "Read prices carefully from the menu or price list.", "visual": {"kind": "scene", "rows": [[{"type": "money", "items": ["note-20", "note-20"], "label": "You pay $40", "focus": [2]}], [{"type": "text", "text": "3 × $12 = $36", "focus": [1]}], [{"type": "text", "text": "Change: $4", "big": true, "tone": "answer", "step": 3, "focus": [3]}]]} },
  "8:3": { "idea": "Multi-step problems: total each part, add them, then answer the question.", "example": "3 × $12 + 4 × $7.50 = $66", "steps": ["Find the cost of each item type.", "Add them for the total.", "If you paid, subtract the total from what you paid."], "tip": "Check your final answer matches what the question asks.", "visual": {"kind": "scene", "rows": [[{"type": "chips", "items": ["3 × $12 = $36", "4 × $7.50 = $30"], "focus": [1]}], [{"type": "text", "text": "$36 + $30 = $66", "big": true, "tone": "answer", "step": 2, "focus": [2]}]]} },
  "9:1": { "idea": "Equivalent fractions show the same amount with different numbers of parts.", "example": "2/5 = 4/10", "steps": ["Multiply the top and bottom by the same number, 2.", "2 × 2 = 4 and 5 × 2 = 10.", "So 2/5 and 4/10 are the same amount."], "tip": "Whatever you do to the bottom, do to the top.", "visual": {"kind": "scene", "rows": [[{"type": "fraction", "shape": "bar", "parts": 5, "shaded": 2, "label": "2/5", "focus": [1]}, {"type": "fraction", "shape": "bar", "parts": 10, "shaded": 4, "label": "4/10", "focus": [2, 3]}], [{"type": "text", "text": "2/5 = 4/10", "big": true, "tone": "answer", "step": 3, "focus": [3]}]]} },
  "9:2": { "idea": "Tenths can be written as fractions or decimals.", "example": "6/10 = 0.6", "steps": ["6/10 means 6 tenths.", "Tenths go in the first place after the point.", "So 6/10 = 0.6."], "tip": "1/2 is 5/10, which is 0.5.", "visual": {"kind": "scene", "rows": [[{"type": "fraction", "shape": "bar", "parts": 10, "shaded": 6, "label": "6/10", "focus": [1]}], [{"type": "text", "text": "6/10 = 0.6", "big": true, "tone": "answer", "step": 3, "focus": [3]}]]} },
  "9:3": { "idea": "Check equivalence by scaling or by drawing the bars.", "example": "Is 3/8 = 6/16? → yes, × 2", "steps": ["Look for one number that multiplies both 3 → 6 and 8 → 16.", "Both use × 2.", "So they are equivalent."], "tip": "If the top and bottom scale by different numbers, they are not equivalent.", "visual": {"kind": "scene", "rows": [[{"type": "fraction", "shape": "bar", "parts": 8, "shaded": 3, "label": "3/8", "focus": [1]}, {"type": "fraction", "shape": "bar", "parts": 16, "shaded": 6, "label": "6/16", "focus": [1, 2]}], [{"type": "text", "text": "Both × 2: equivalent", "big": true, "tone": "answer", "step": 3, "focus": [3]}]]} },
  "10:1": { "idea": "Counting by a fraction adds the same fraction each step.", "example": "Count by 1/6: 1/6, 2/6, 3/6, 4/6, 5/6, 6/6", "steps": ["Start at 1/6.", "Add 1/6 each step: only the top number goes up.", "6/6 is one whole."], "tip": "The bottom number stays the same as you count.", "visual": {"kind": "scene", "rows": [[{"type": "visual", "visual": {"kind": "numberLine", "min": 0, "max": 1, "step": 0.16666666666666666, "labelEvery": 1, "marks": [{"value": 0.16666666666666666, "label": "1/6"}, {"value": 0.5, "label": "3/6"}, {"value": 1, "label": "6/6"}]}, "focus": [1, 2, 3]}]]} },
  "10:2": { "idea": "A mixed numeral is wholes plus a fraction.", "example": "14/5 = 2 4/5", "steps": ["5 fifths make 1 whole.", "14 ÷ 5 = 2 wholes with 4 fifths left over.", "So 14/5 = 2 4/5."], "tip": "Check: 2 × 5 + 4 = 14.", "visual": {"kind": "scene", "rows": [[{"type": "fraction", "shape": "bar", "parts": 5, "shaded": 5, "label": "1"}, {"type": "fraction", "shape": "bar", "parts": 5, "shaded": 5, "label": "2"}, {"type": "fraction", "shape": "bar", "parts": 5, "shaded": 4, "label": "4/5", "focus": [2]}], [{"type": "text", "text": "14/5 = 2 4/5", "big": true, "tone": "answer", "step": 3, "focus": [3]}]]} },
  "10:3": { "idea": "Place a fraction by splitting each whole into equal parts.", "example": "5/8 → 5 of 8 equal spaces from 0", "steps": ["Split 0 to 1 into 8 equal spaces.", "Count 5 spaces from 0.", "That point is 5/8, a bit past halfway."], "tip": "Halfway is 4/8, which helps you check.", "visual": {"kind": "scene", "rows": [[{"type": "visual", "visual": {"kind": "numberLine", "min": 0, "max": 1, "step": 0.125, "labelEvery": 1, "marks": [{"value": 0.625, "label": "5/8"}]}, "focus": [1, 2, 3]}]]} },
  "11:1": { "idea": "An addition algorithm adds the same amount each time.", "example": "Start 4, add 5 → 4, 9, 14, 19", "steps": ["Output 1 is the start: 4.", "Add 5 to get each next output: 9, 14, 19.", "Output 4 is 19."], "tip": "Count the start number as output 1.", "visual": {"kind": "scene", "rows": [[{"type": "machine", "input": "4", "rule": "+ 5", "output": "9", "outputStep": 2, "focus": [1, 2]}], [{"type": "chips", "items": ["4", "9", "14", "19"], "arrows": true, "marked": [3], "markStep": 3, "focus": [2, 3]}]]} },
  "11:2": { "idea": "A multiplication algorithm multiplies by the same number each time.", "example": "Start 2, × 2 → 2, 4, 8, 16", "steps": ["Output 1 is 2.", "Multiply each output by 2: 4, 8, 16.", "Output 4 is 16."], "tip": "Multiplying grows much faster than adding.", "visual": {"kind": "scene", "rows": [[{"type": "machine", "input": "2", "rule": "× 2", "output": "4", "outputStep": 2, "focus": [1, 2]}], [{"type": "chips", "items": ["2", "4", "8", "16"], "arrows": true, "marked": [3], "markStep": 3, "focus": [2, 3]}]]} },
  "11:3": { "idea": "Order the steps so the algorithm makes the right outputs.", "example": "Start 4, × 3 → 4, 12, 36, 108", "steps": ["Put the start step first.", "Then the rule that repeats: multiply by 3.", "Check the outputs: 4, 12, 36, 108."], "tip": "Test your order by running it.", "visual": {"kind": "scene", "rows": [[{"type": "chips", "items": ["Start: 4", "Repeat: × 3"], "arrows": true, "focus": [1, 2]}], [{"type": "chips", "items": ["4", "12", "36", "108"], "arrows": true, "step": 3, "focus": [3]}]]} },
  "12:1": { "idea": "Fractions, decimals and number lines can show the same value.", "example": "5/10 = 1/2 = 0.5", "steps": ["5/10 means 5 tenths, which is 0.5.", "5 out of 10 is also half.", "So 5/10, 1/2 and 0.5 are equal."], "tip": "Halfway on a 0 to 1 line is 0.5.", "visual": {"kind": "scene", "rows": [[{"type": "fraction", "shape": "bar", "parts": 10, "shaded": 5, "label": "5/10 = 0.5", "focus": [1]}, {"type": "fraction", "shape": "bar", "parts": 2, "shaded": 1, "label": "1/2", "focus": [2]}], [{"type": "text", "text": "5/10 = 1/2 = 0.5", "big": true, "tone": "answer", "step": 3, "focus": [3]}]]} },
  "12:2": { "idea": "Solve a problem, then check it with an estimate.", "example": "84 ÷ 4 ≈ 200? → 80 ÷ 4 = 20, so no", "steps": ["Round to easy numbers: 84 is about 80.", "80 ÷ 4 = 20.", "200 is far too big, so the claim is wrong."], "tip": "Ask: is the answer about the right size?", "visual": {"kind": "scene", "rows": [[{"type": "text", "text": "84 ÷ 4 ≈ 200?", "focus": [1]}], [{"type": "text", "text": "80 ÷ 4 = 20", "step": 2, "focus": [2]}], [{"type": "text", "text": "200 is far too big", "big": true, "tone": "answer", "step": 3, "focus": [3]}]]} },
  "12:3": { "idea": "Use powers of 10 and algorithms together.", "example": "8,970 ÷ 10 = 897", "steps": ["÷ 10 moves each digit one place right.", "8 thousands become 8 hundreds.", "The answer is 897."], "tip": "Multiplying and dividing by the same power of 10 undo each other.", "visual": {"kind": "scene", "rows": [[{"type": "chips", "items": ["8,970", "÷ 10", "897"], "arrows": true, "focus": [1, 2, 3]}]]} }
}
