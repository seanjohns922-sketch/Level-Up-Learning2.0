{
  "1:1": { "idea": "Decimal places go tenths, hundredths, thousandths. Each is 10 times smaller.", "example": "4.204 = 4 + 0.2 + 0.004", "steps": ["4 is in the ones place.", "2 is in the tenths place: 0.2.", "0 hundredths, then 4 in the thousandths place: 0.004."], "tip": "2.3 = 2.30 = 2.300. Zeros on the end don't change the value.", "visual": {"kind": "scene", "rows": [[{"type": "chips", "items": ["Ones: 4", "Tenths: 2", "Hundredths: 0", "Thousandths: 4"], "focus": [1, 2, 3]}], [{"type": "text", "text": "4 + 0.2 + 0.004", "big": true, "tone": "answer", "step": 3, "focus": [3]}]]} },
  "1:2": { "idea": "Pick the strategy that suits the numbers before you calculate.", "example": "602 − 198 = 602 − 200 + 2 = 404", "steps": ["198 is close to 200, so subtract 200: 402.", "You took away 2 too many.", "Add 2 back: 404."], "tip": "Numbers near a round number are a sign to use compensation.", "visual": {"kind": "scene", "rows": [[{"type": "line", "min": 390, "max": 610, "tick": 10, "labelEvery": 50, "jumps": [{"from": 602, "to": 402, "text": "−200", "step": 1}, {"from": 402, "to": 404, "text": "+2", "step": 3}], "marks": [{"value": 602, "text": "602"}, {"value": 404, "text": "404", "tone": "answer", "step": 3}], "focus": [1, 2, 3]}]]} },
  "1:3": { "idea": "Use nearby benchmarks to place a decimal on a line.", "example": "2.505 lies between 2.5 and 2.6", "steps": ["Look at the tenths: 2.505 has 5 tenths.", "So it is at least 2.5 but less than 2.6.", "It is just past 2.5."], "tip": "Compare tenths first, then hundredths.", "visual": {"kind": "scene", "rows": [[{"type": "line", "min": 2.5, "max": 2.6, "tick": 0.01, "labelEvery": 0.05, "marks": [{"value": 2.505, "text": "2.505", "tone": "answer", "step": 3}], "focus": [1, 2, 3]}]]} },
  "2:1": { "idea": "Money is written with 2 decimal places. Add prices by lining up the points.", "example": "$2.80 + $2.80 = $5.60", "steps": ["Line up the decimal points.", "Add the cents: 80c + 80c = $1.60.", "Add the dollars: $2 + $2 + $1.60 = $5.60."], "tip": "Always write money with two digits after the point: $5.60, not $5.6.", "visual": {"kind": "scene", "rows": [[{"type": "column", "op": "+", "top": "2.80", "bottom": "2.80", "carries": ["1", " ", " ", " "], "carryStep": 2, "answer": "5.60", "answerStep": 3, "focus": [1, 2, 3]}]]} },
  "2:2": { "idea": "To round a decimal, look at the next digit to the right.", "example": "7.558 to the nearest hundredth → 7.56", "steps": ["The hundredths digit is 5.", "Look at the next digit: 8 is 5 or more.", "Round the 5 up to 6: 7.56."], "tip": "Drop the digits after the rounding place.", "visual": {"kind": "scene", "rows": [[{"type": "line", "min": 7.55, "max": 7.56, "tick": 0.001, "labelEvery": 0.005, "marks": [{"value": 7.558, "text": "7.558"}, {"value": 7.56, "tone": "answer", "step": 3, "text": "7.56"}], "focus": [1, 2, 3]}], [{"type": "text", "text": "7.56", "big": true, "tone": "answer", "step": 3, "focus": [3]}]]} },
  "2:3": { "idea": "Estimate with whole numbers to check a decimal answer.", "example": "$4.95 + $2.20 ≈ $5 + $2 = $7; $70 is not reasonable", "steps": ["Round each price to the nearest dollar.", "Add: about $7.", "$70 is 10 times too big, so it is wrong."], "tip": "A misplaced decimal point often makes an answer 10 times too big or small.", "visual": {"kind": "scene", "rows": [[{"type": "chips", "items": ["$4.95 ≈ $5", "$2.20 ≈ $2"], "focus": [1]}], [{"type": "text", "text": "About $7", "step": 2, "focus": [2]}], [{"type": "text", "text": "$70 is 10 times too big", "big": true, "tone": "answer", "step": 3, "focus": [3]}]]} },
  "3:1": { "idea": "Factors multiply to make a number. Multiples are in its times table.", "example": "Factors of 24: 1, 2, 3, 4, 6, 8, 12, 24", "steps": ["Find factor pairs: 1 × 24, 2 × 12, 3 × 8, 4 × 6.", "List every number in the pairs.", "Multiples of 24 are 24, 48, 72 … ."], "tip": "Factors are at most the number; multiples are at least the number.", "visual": {"kind": "scene", "rows": [[{"type": "chips", "items": ["1 × 24", "2 × 12", "3 × 8", "4 × 6"], "focus": [1, 2]}], [{"type": "text", "text": "Multiples: 24, 48, 72 …", "step": 3, "focus": [3]}]]} },
  "3:2": { "idea": "Divisibility tests check a number without dividing.", "example": "534: even and digit sum 12 → divisible by 6", "steps": ["Divisible by 2: it ends in 4, so yes.", "Divisible by 3: 5 + 3 + 4 = 12, and 12 is a multiple of 3.", "Divisible by 2 and 3 means divisible by 6."], "tip": "By 5: ends in 0 or 5. By 10: ends in 0.", "visual": {"kind": "scene", "rows": [[{"type": "chips", "items": ["Ends in 4: ÷ 2 ✓", "5 + 3 + 4 = 12: ÷ 3 ✓"], "focus": [1, 2]}], [{"type": "text", "text": "534 is divisible by 6", "big": true, "tone": "answer", "step": 3, "focus": [3]}]]} },
  "3:3": { "idea": "Follow a divisibility algorithm step by step.", "example": "Is 4,347 divisible by 9? 4 + 3 + 4 + 7 = 18 → yes", "steps": ["Add the digits: 4 + 3 + 4 + 7 = 18.", "18 is a multiple of 9.", "So 4,347 is divisible by 9."], "tip": "Do every step in order; don't skip one.", "visual": {"kind": "scene", "rows": [[{"type": "text", "text": "4 + 3 + 4 + 7 = 18", "focus": [1]}], [{"type": "text", "text": "18 is a multiple of 9: yes", "big": true, "tone": "answer", "step": 2, "focus": [2]}]]} },
  "4:1": { "idea": "Patterns in multiples come from the rule that makes them.", "example": "84, 96, 108, 120 → add 12", "steps": ["Find the gap: 96 − 84 = 12.", "Check the next gap is also 12.", "Continue the rule: 108."], "tip": "Check the rule works for every pair, not just the first.", "visual": {"kind": "scene", "rows": [[{"type": "line", "min": 80, "max": 125, "tick": 5, "labelEvery": 10, "jumps": [{"from": 84, "to": 96, "text": "+12"}, {"from": 96, "to": 108, "text": "+12", "step": 3}, {"from": 108, "to": 120, "text": "+12", "step": 3}], "focus": [1, 2, 3]}]]} },
  "4:2": { "idea": "Use divisibility rules to decide quickly, and explain why.", "example": "555 by 3 and 5? digit sum 15, ends in 5 → yes", "steps": ["Digit sum: 5 + 5 + 5 = 15, a multiple of 3.", "It ends in 5, so it is divisible by 5.", "So 555 is divisible by both."], "tip": "Give the rule as your reason.", "visual": {"kind": "scene", "rows": [[{"type": "chips", "items": ["5 + 5 + 5 = 15: ÷ 3 ✓", "Ends in 5: ÷ 5 ✓"], "focus": [1, 2]}], [{"type": "text", "text": "555 is divisible by both", "big": true, "tone": "answer", "step": 3, "focus": [3]}]]} },
  "4:3": { "idea": "Explain why a pattern in multiples happens.", "example": "30, 40, 50, 60 all end in 0 because adding 10 keeps the ones at 0", "steps": ["Look at what changes each step: + 10.", "Adding 10 changes the tens but not the ones digit.", "So the ones digit stays 0."], "tip": "Link the pattern back to the rule.", "visual": {"kind": "scene", "rows": [[{"type": "chips", "items": ["30", "40", "50", "60"], "arrows": true, "focus": [1, 2]}], [{"type": "text", "text": "+ 10 changes the tens, not the ones", "step": 2, "focus": [2, 3]}]]} },
  "5:1": { "idea": "Multiply each place value part, then add.", "example": "506 × 3 = 1,500 + 0 + 18 = 1,518", "steps": ["Split 506 into 500 and 6.", "500 × 3 = 1,500 and 6 × 3 = 18.", "1,500 + 18 = 1,518."], "tip": "300 × 4 is 1,200, not 120. Keep the zeros.", "visual": {"kind": "scene", "rows": [[{"type": "chips", "items": ["500 × 3 = 1,500", "6 × 3 = 18"], "focus": [1, 2]}], [{"type": "text", "text": "1,518", "big": true, "tone": "answer", "step": 3, "focus": [3]}]]} },
  "5:2": { "idea": "Use friendly numbers to multiply faster.", "example": "25 × 16 = 25 × 4 × 4 = 100 × 4 = 400", "steps": ["16 = 4 × 4.", "25 × 4 = 100.", "100 × 4 = 400."], "tip": "25 × 4 = 100 is a very useful fact.", "visual": {"kind": "scene", "rows": [[{"type": "chips", "items": ["25 × 16", "25 × 4 × 4", "100 × 4"], "arrows": true, "focus": [1, 2]}], [{"type": "text", "text": "400", "big": true, "tone": "answer", "step": 3, "focus": [3]}]]} },
  "5:3": { "idea": "Estimate first so you can tell if the answer is reasonable.", "example": "57 × 32 = 3,824? Estimate 60 × 30 = 1,800 → too large", "steps": ["Round: 57 ≈ 60 and 32 ≈ 30.", "60 × 30 = 1,800.", "3,824 is about twice the estimate, so it is wrong. The real answer is 1,824."], "tip": "Round both numbers to one significant digit to estimate.", "visual": {"kind": "scene", "rows": [[{"type": "text", "text": "60 × 30 = 1,800", "focus": [1, 2]}], [{"type": "text", "text": "3,824 is far too large: it is 1,824", "big": true, "tone": "answer", "step": 3, "focus": [3]}]]} },
  "6:1": { "idea": "A remainder is what is left after making equal groups.", "example": "94 ÷ 8 = 11 r 6", "steps": ["How many 8s fit in 94? 8 × 11 = 88.", "94 − 88 = 6 left over.", "Check: 8 × 11 + 6 = 94."], "tip": "The remainder must be smaller than the number you divide by.", "visual": {"kind": "scene", "rows": [[{"type": "groups", "groups": 11, "each": 8, "label": "11 groups of 8 = 88", "focus": [1]}, {"type": "counters", "n": 6, "label": "6 left over", "step": 2, "focus": [2]}], [{"type": "text", "text": "11 r 6", "big": true, "tone": "answer", "step": 3, "focus": [3]}]]} },
  "6:2": { "idea": "The story decides what to do with a remainder.", "example": "47 students, 6 per row → 47 ÷ 6 = 7 r 5 → 8 rows", "steps": ["47 ÷ 6 = 7 rows with 5 students left over.", "Those 5 students still need a row.", "So 8 rows are needed."], "tip": "Round up when everyone needs a place; round down for full groups only.", "visual": {"kind": "scene", "rows": [[{"type": "array", "rows": 7, "cols": 6, "label": "7 full rows of 6", "focus": [1]}, {"type": "counters", "n": 5, "label": "5 students left over", "focus": [2]}], [{"type": "text", "text": "8 rows", "big": true, "tone": "answer", "step": 3, "focus": [3]}]]} },
  "6:3": { "idea": "Estimate a division with compatible numbers, then check.", "example": "143 ÷ 7 ≈ 140 ÷ 7 = 20", "steps": ["Change 143 to a nearby number 7 divides easily: 140.", "140 ÷ 7 = 20.", "So 143 ÷ 7 is about 20 (it is 20 r 3)."], "tip": "Check a division with quotient × divisor + remainder.", "visual": {"kind": "scene", "rows": [[{"type": "text", "text": "143 ≈ 140", "focus": [1]}], [{"type": "text", "text": "140 ÷ 7 = 20", "big": true, "tone": "answer", "step": 2, "focus": [2]}]]} },
  "7:1": { "idea": "Equivalent fractions are equal even though the numbers differ.", "example": "1/4 = 3/12", "steps": ["Multiply the top and bottom by 3.", "1 × 3 = 3 and 4 × 3 = 12.", "So 1/4 and 3/12 are equal."], "tip": "7/8 is not equal to 3/4, because 3/4 = 6/8.", "visual": {"kind": "scene", "rows": [[{"type": "fraction", "shape": "bar", "parts": 4, "shaded": 1, "label": "1/4", "focus": [1]}, {"type": "fraction", "shape": "bar", "parts": 12, "shaded": 3, "label": "3/12", "focus": [2, 3]}], [{"type": "text", "text": "1/4 = 3/12", "big": true, "tone": "answer", "step": 3, "focus": [3]}]]} },
  "7:2": { "idea": "Compare fractions using a common denominator or a benchmark.", "example": "2/3 vs 3/4 → 8/12 < 9/12", "steps": ["Rename both with denominator 12: 2/3 = 8/12 and 3/4 = 9/12.", "Compare the tops: 8 < 9.", "So 2/3 < 3/4."], "tip": "With the same bottom number, the bigger top is the bigger fraction.", "visual": {"kind": "scene", "rows": [[{"type": "fraction", "shape": "bar", "parts": 12, "shaded": 8, "label": "2/3 = 8/12", "focus": [1, 2]}, {"type": "fraction", "shape": "bar", "parts": 12, "shaded": 9, "label": "3/4 = 9/12", "focus": [1, 2]}], [{"type": "text", "text": "2/3 < 3/4", "big": true, "tone": "answer", "step": 3, "focus": [3]}]]} },
  "7:3": { "idea": "Split the line from 0 to 1 into the fraction's equal parts.", "example": "7/10 → 7 of 10 equal spaces from 0", "steps": ["Split 0 to 1 into 10 equal spaces.", "Count 7 spaces from 0.", "Check: 7/10 is past halfway (5/10)."], "tip": "Use 1/2 as a checkpoint.", "visual": {"kind": "scene", "rows": [[{"type": "visual", "visual": {"kind": "numberLine", "min": 0, "max": 1, "step": 0.1, "labelEvery": 1, "marks": [{"value": 0.5, "label": "5/10"}, {"value": 0.7, "label": "7/10"}]}, "focus": [1, 2, 3]}]]} },
  "8:1": { "idea": "With the same denominator, add or subtract the numerators only.", "example": "2/7 + 3/7 = 5/7", "steps": ["Both fractions are sevenths.", "Add the tops: 2 + 3 = 5.", "Keep the bottom: 5/7."], "tip": "Don't add the bottoms. 2/7 + 3/7 is not 5/14.", "visual": {"kind": "scene", "rows": [[{"type": "fraction", "shape": "bar", "parts": 7, "shaded": 2, "label": "2/7"}, {"type": "sign", "text": "+"}, {"type": "fraction", "shape": "bar", "parts": 7, "shaded": 3, "label": "3/7"}], [{"type": "fraction", "shape": "bar", "parts": 7, "shaded": 5, "label": "5/7", "step": 2, "focus": [2, 3]}]]} },
  "8:2": { "idea": "Rename one fraction so both have the same size parts.", "example": "2/3 + 1/6 = 4/6 + 1/6 = 5/6", "steps": ["6 is a multiple of 3, so use sixths.", "2/3 = 4/6.", "4/6 + 1/6 = 5/6."], "tip": "Multiply the top and bottom by the same number when renaming.", "visual": {"kind": "scene", "rows": [[{"type": "fraction", "shape": "bar", "parts": 3, "shaded": 2, "label": "2/3", "focus": [1]}, {"type": "sign", "text": "="}, {"type": "fraction", "shape": "bar", "parts": 6, "shaded": 4, "label": "4/6", "focus": [2]}], [{"type": "text", "text": "4/6 + 1/6 = 5/6", "big": true, "tone": "answer", "step": 3, "focus": [3]}]]} },
  "8:3": { "idea": "In word problems, match the denominators first, then add or subtract.", "example": "4/5 − 3/10 = 8/10 − 3/10 = 5/10 = 1/2", "steps": ["Rename 4/5 as tenths: 8/10.", "Subtract: 8/10 − 3/10 = 5/10.", "Simplify: 5/10 = 1/2."], "tip": "Simplify your answer at the end.", "visual": {"kind": "scene", "rows": [[{"type": "fraction", "shape": "bar", "parts": 10, "shaded": 8, "label": "4/5 = 8/10", "focus": [1]}], [{"type": "fraction", "shape": "bar", "parts": 10, "shaded": 5, "label": "8/10 − 3/10 = 5/10", "step": 2, "focus": [2]}], [{"type": "text", "text": "= 1/2", "big": true, "tone": "answer", "step": 3, "focus": [3]}]]} },
  "9:1": { "idea": "Fractions, decimals and percentages can show the same amount.", "example": "1/50 = 2/100 = 0.02 = 2%", "steps": ["Make the denominator 100: 1/50 = 2/100.", "2 hundredths is 0.02.", "Per cent means out of 100, so it is 2%."], "tip": "Getting to /100 makes converting easy.", "visual": {"kind": "scene", "rows": [[{"type": "fraction", "shape": "square", "parts": 100, "shaded": 2, "focus": [1, 2]}], [{"type": "text", "text": "1/50 = 2/100 = 0.02 = 2%", "big": true, "tone": "answer", "step": 3, "focus": [3]}]]} },
  "9:2": { "idea": "Compare values to benchmarks 0, 1/2 and 1.", "example": "3/8 is closest to 1/2", "steps": ["1/2 = 4/8.", "3/8 is only 1/8 away from 1/2.", "It is 3/8 away from 0, so 1/2 is closest."], "tip": "Turn values into the same form to compare them.", "visual": {"kind": "scene", "rows": [[{"type": "visual", "visual": {"kind": "numberLine", "min": 0, "max": 1, "step": 0.125, "labelEvery": 0.5, "marks": [{"value": 0.375, "label": "3/8"}, {"value": 0.5, "label": "4/8"}]}, "focus": [1, 2, 3]}]]} },
  "9:3": { "idea": "Convert to one form, then calculate.", "example": "50% + 1/8 = 4/8 + 1/8 = 5/8", "steps": ["50% = 1/2 = 4/8.", "Add: 4/8 + 1/8 = 5/8.", "The answer is 5/8."], "tip": "Choose the form that makes the calculation easiest.", "visual": {"kind": "scene", "rows": [[{"type": "fraction", "shape": "bar", "parts": 8, "shaded": 4, "label": "50% = 4/8", "focus": [1]}, {"type": "sign", "text": "+"}, {"type": "fraction", "shape": "bar", "parts": 8, "shaded": 1, "label": "1/8", "focus": [2]}], [{"type": "text", "text": "5/8", "big": true, "tone": "answer", "step": 3, "focus": [3]}]]} },
  "10:1": { "idea": "100% is the whole. Any fraction can be written as a percentage.", "example": "5/8 = 0.625 = 62.5%", "steps": ["Divide the top by the bottom: 5 ÷ 8 = 0.625.", "Multiply by 100 for per cent: 62.5%.", "So 5/8 = 0.625 = 62.5%."], "tip": "100% = 1 whole, 50% = a half, 25% = a quarter.", "visual": {"kind": "scene", "rows": [[{"type": "chips", "items": ["5 ÷ 8 = 0.625", "0.625 × 100 = 62.5%"], "arrows": true, "focus": [1, 2]}], [{"type": "text", "text": "5/8 = 0.625 = 62.5%", "big": true, "tone": "answer", "step": 3, "focus": [3]}]]} },
  "10:2": { "idea": "Compare percentages using fractions you know.", "example": "12% is closest to 0; 70% is closest to 1/2", "steps": ["Benchmarks: 0% = 0, 50% = 1/2, 100% = 1.", "12% is only 12 away from 0.", "70% is 30 from 100% and 20 from 50%, so it is closer to 1/2."], "tip": "Measure how far each value is from each benchmark.", "visual": {"kind": "scene", "rows": [[{"type": "line", "min": 0, "max": 100, "tick": 10, "labelEvery": 50, "marks": [{"value": 12, "text": "12%"}, {"value": 70, "text": "70%"}], "focus": [1, 2, 3]}]]} },
  "10:3": { "idea": "A percentage describes part of a whole in a picture or a story.", "example": "2/5 = 40%", "steps": ["Make the whole 100: 2/5 = 40/100.", "40 out of 100 is 40%.", "So 2 of 5 parts is 40%."], "tip": "90% means 90 out of every 100.", "visual": {"kind": "scene", "rows": [[{"type": "fraction", "shape": "bar", "parts": 5, "shaded": 2, "label": "2/5", "focus": [1]}, {"type": "sign", "text": "="}, {"type": "fraction", "shape": "square", "parts": 100, "shaded": 40, "label": "40/100", "focus": [1, 2]}], [{"type": "text", "text": "40%", "big": true, "tone": "answer", "step": 3, "focus": [3]}]]} },
  "11:1": { "idea": "Break a real problem into steps and do them in order.", "example": "Serves 4, triple it, remove 2 → 4 × 3 − 2 = 10", "steps": ["Triple the recipe: 4 × 3 = 12 portions.", "Remove 2 portions: 12 − 2.", "10 portions are left."], "tip": "Write each step's result before the next step.", "visual": {"kind": "scene", "rows": [[{"type": "groups", "groups": 3, "each": 4, "label": "Triple: 12 portions", "focus": [1]}], [{"type": "text", "text": "12 − 2 = 10 left", "big": true, "tone": "answer", "step": 3, "focus": [3]}]]} },
  "11:2": { "idea": "Choose an efficient strategy for each calculation.", "example": "2,499 + 518 = 2,500 + 518 − 1 = 3,017", "steps": ["2,499 is 1 less than 2,500.", "2,500 + 518 = 3,018.", "Take off the 1: 3,017."], "tip": "Look for numbers close to a round number.", "visual": {"kind": "scene", "rows": [[{"type": "line", "min": 2500, "max": 3100, "tick": 100, "labelEvery": 200, "jumps": [{"from": 2500, "to": 3018, "text": "+518", "step": 2}, {"from": 3018, "to": 3017, "text": "−1", "step": 3}], "marks": [{"value": 3017, "text": "3,017", "tone": "answer", "step": 3}], "focus": [1, 2, 3]}]]} },
  "11:3": { "idea": "Estimate quickly to decide if an answer makes sense.", "example": "1,000 ÷ 8 = 80? 8 × 80 = 640 → no", "steps": ["Check by multiplying back: 8 × 80 = 640.", "640 is much less than 1,000.", "So 80 is too small; the answer is 125."], "tip": "Inverse operations are a quick check.", "visual": {"kind": "scene", "rows": [[{"type": "text", "text": "1,000 ÷ 8 = 80?", "focus": [1]}], [{"type": "text", "text": "8 × 80 = 640", "step": 1, "focus": [1, 2]}], [{"type": "text", "text": "Too small: it is 125", "big": true, "tone": "answer", "step": 3, "focus": [3]}]]} },
  "12:1": { "idea": "Review: decimals, fractions and percentages are different forms of the same values.", "example": "2.35 = 2.350; 3/8 < 1/2 < 5/8", "steps": ["Adding a zero to the end of a decimal keeps its value.", "To order fractions, compare them with 1/2 or use a common denominator.", "Check by changing to one form."], "tip": "Read the place value carefully.", "visual": {"kind": "scene", "rows": [[{"type": "chips", "items": ["2.35", "2.350"], "focus": [1]}], [{"type": "fraction", "shape": "bar", "parts": 8, "shaded": 3, "label": "3/8"}, {"type": "fraction", "shape": "bar", "parts": 2, "shaded": 1, "label": "1/2"}, {"type": "fraction", "shape": "bar", "parts": 8, "shaded": 5, "label": "5/8"}]]} },
  "12:2": { "idea": "Review: multi-step calculations go left to right for + and −.", "example": "5.98 − 2.49 + 1.2 = 3.49 + 1.2 = 4.69", "steps": ["Do the first step: 5.98 − 2.49 = 3.49.", "Then the second: 3.49 + 1.2 = 4.69.", "Check with an estimate: 6 − 2.5 + 1 = 4.5."], "tip": "Line up decimal points in every step.", "visual": {"kind": "scene", "rows": [[{"type": "chips", "items": ["5.98 − 2.49 = 3.49", "3.49 + 1.2 = 4.69"], "arrows": true, "focus": [1, 2]}], [{"type": "text", "text": "Check: 6 − 2.5 + 1 = 4.5", "step": 3, "focus": [3]}]]} },
  "12:3": { "idea": "Review: factors, multiples and divisibility rules.", "example": "245 ends in 5, not 0 → not divisible by 10", "steps": ["By 10: the number must end in 0.", "245 ends in 5.", "So it is divisible by 5, but not by 10."], "tip": "Match the right rule to the divisor.", "visual": {"kind": "scene", "rows": [[{"type": "chips", "items": ["245"], "focus": [1, 2]}], [{"type": "text", "text": "Ends in 5: ÷ 5, not ÷ 10", "big": true, "tone": "answer", "step": 3, "focus": [3]}]]} }
}
