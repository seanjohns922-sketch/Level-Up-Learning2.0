{
  "1:1": {"idea": "A 3-digit number is made of hundreds, tens and ones.", "example": "6 hundreds, 5 tens, 3 ones → 653", "steps": ["Write the hundreds digit first: 6.", "Then the tens digit: 5.", "Then the ones digit: 3. The number is 653."], "tip": "If there are no tens, write 0 in the tens place: 6 hundreds and 3 ones is 603.", "visual": {"kind": "scene", "rows": [[{"type": "blocks", "hundreds": 6, "label": "6 hundreds", "focus": [1]}, {"type": "blocks", "tens": 5, "label": "5 tens", "focus": [2], "step": 2}, {"type": "blocks", "ones": 3, "label": "3 ones", "focus": [3], "step": 3}], [{"type": "text", "text": "653", "big": true, "tone": "answer", "step": 3, "focus": [3]}]]}},
  "1:2": {"idea": "Compare the blocks with the number to find what is missing.", "example": "Number 579. Blocks show 5 hundreds and 9 ones → missing tens = 70", "steps": ["Read each digit of 579: 5 hundreds, 7 tens, 9 ones.", "Check the blocks: the hundreds and ones are there.", "The 7 tens are missing. Their value is 70."], "tip": "Value of the missing part means its total: 7 tens is 70, not 7.", "visual": {"kind": "scene", "rows": [[{"type": "blocks", "hundreds": 5, "label": "5 hundreds", "focus": [2]}, {"type": "text", "text": "? tens", "tone": "unknown", "big": true, "focus": [3], "then": {"step": 3, "text": "7 tens = 70"}}, {"type": "blocks", "ones": 9, "label": "9 ones", "focus": [2]}], [{"type": "chips", "items": ["5 hundreds", "7 tens", "9 ones"], "label": "579", "focus": [1]}]]}},
  "1:3": {"idea": "Order 3-digit numbers by comparing hundreds, then tens, then ones.", "example": "480, 190, 566 → 190, 480, 566", "steps": ["Compare the hundreds: 1, 4 and 5.", "Fewest hundreds is smallest: 190.", "Then 480, then 566."], "tip": "Only look at the tens if the hundreds are the same.", "visual": {"kind": "scene", "rows": [[{"type": "chips", "items": ["480", "190", "566"], "focus": [1]}], [{"type": "line", "min": 0, "max": 600, "tick": 100, "step": 2, "focus": [2, 3], "marks": [{"value": 190, "text": "190", "step": 2}, {"value": 480, "text": "480", "step": 3}, {"value": 566, "text": "566", "step": 3}]}], [{"type": "text", "text": "190, 480, 566", "big": true, "tone": "answer", "step": 3, "focus": [3]}]]}},
  "2:1": {"idea": "Each digit's place tells its value.", "example": "823 = 800 + 20 + 3", "steps": ["8 is in the hundreds place: 800.", "2 is in the tens place: 20.", "3 is in the ones place: 3."], "tip": "A 0 digit means none of that place: 806 = 800 + 6.", "visual": {"kind": "scene", "rows": [[{"type": "blocks", "hundreds": 8, "label": "800", "focus": [1]}, {"type": "sign", "text": "+", "step": 2}, {"type": "blocks", "tens": 2, "label": "20", "focus": [2], "step": 2}, {"type": "sign", "text": "+", "step": 3}, {"type": "blocks", "ones": 3, "label": "3", "focus": [3], "step": 3}]]}},
  "2:2": {"idea": "Expanded form writes a number as the sum of its place values.", "example": "348 = 300 + 40 + 8", "steps": ["Write the hundreds value: 300.", "Write the tens value: 40.", "Write the ones value: 8, then join with +."], "tip": "Write values, not digits: 40, not 4.", "visual": {"kind": "scene", "rows": [[{"type": "blocks", "hundreds": 3, "label": "300", "focus": [1]}, {"type": "sign", "text": "+", "step": 2}, {"type": "blocks", "tens": 4, "label": "40", "focus": [2], "step": 2}, {"type": "sign", "text": "+", "step": 3}, {"type": "blocks", "ones": 8, "label": "8", "focus": [3], "step": 3}], [{"type": "text", "text": "300 + 40 + 8", "big": true, "tone": "answer", "step": 3, "focus": [3]}]]}},
  "2:3": {"idea": "You can regroup 1 hundred as 10 tens. The number stays the same.", "example": "825: regroup 1 hundred → 7 hundreds, 12 tens, 5 ones", "steps": ["825 has 8 hundreds, 2 tens and 5 ones.", "Break 1 hundred into 10 tens: 2 tens + 10 tens = 12 tens.", "Now 7 hundreds, 12 tens and 5 ones still make 825."], "tip": "Regrouping changes how it is shown, not the total.", "visual": {"kind": "scene", "rows": [[{"type": "blocks", "hundreds": 8, "tens": 2, "ones": 5, "label": "8 hundreds, 2 tens, 5 ones", "focus": [1]}], [{"type": "blocks", "hundreds": 7, "tens": 12, "ones": 5, "label": "7 hundreds, 12 tens, 5 ones", "focus": [2], "step": 2}], [{"type": "text", "text": "still 825", "big": true, "tone": "answer", "step": 3, "focus": [3]}]]}},
  "3:1": {"idea": "Use the marked numbers on a line to place a number in between.", "example": "404 between 394 and 414 → halfway", "steps": ["Find the start and end: 394 and 414. They are 20 apart.", "404 is 10 more than 394, which is half of 20.", "So 404 sits halfway."], "tip": "Find the halfway point first, then judge left or right.", "visual": {"kind": "scene", "rows": [[{"type": "line", "min": 394, "max": 414, "tick": 2, "labelEvery": 10, "focus": [1], "jumps": [{"from": 394, "to": 404, "text": "10", "step": 2}, {"from": 404, "to": 414, "text": "10", "step": 3}], "marks": [{"value": 404, "text": "", "tone": "answer", "step": 2}]}], [{"type": "text", "text": "404 is halfway", "big": true, "tone": "answer", "step": 3, "focus": [3]}]]}},
  "3:2": {"idea": "Rounding to the nearest 10 finds the closest multiple of 10.", "example": "74 → 70", "steps": ["74 is between 70 and 80.", "Look at the ones digit: 4 is less than 5.", "So 74 is closer to 70."], "tip": "A ones digit of 5 or more rounds up: 75 → 80.", "visual": {"kind": "scene", "rows": [[{"type": "line", "min": 70, "max": 80, "tick": 1, "labelEvery": 10, "focus": [1], "marks": [{"value": 74, "text": "74", "tone": "unknown"}, {"value": 75, "text": "75", "step": 2}]}], [{"type": "text", "text": "4 is less than 5", "step": 2, "focus": [2]}], [{"type": "text", "text": "closer to 70", "big": true, "tone": "answer", "step": 3, "focus": [3]}]]}},
  "3:3": {"idea": "Estimate a position by comparing it with the ends and the middle.", "example": "Place 254 on a 0 to 1000 line → a bit past one quarter", "steps": ["The middle of 0 to 1000 is 500. 254 is about half of that.", "So 254 is close to one quarter of the way, at 250.", "Mark it just past the quarter point."], "tip": "Use 250, 500 and 750 as landmarks.", "visual": {"kind": "scene", "rows": [[{"type": "line", "min": 0, "max": 1000, "tick": 250, "labelEvery": 250, "marks": [{"value": 500, "text": "", "step": 1}, {"value": 254, "text": "", "tone": "answer", "step": 3}], "focus": [1, 2]}], [{"type": "text", "text": "254: just past 250", "big": true, "tone": "answer", "step": 3, "focus": [3]}]]}},
  "4:1": {"idea": "Even numbers can be shared into 2 equal groups. Odd numbers have 1 left over.", "example": "18 → even; 21 → odd", "steps": ["Look at the ones digit.", "Ones of 0, 2, 4, 6 or 8 means even: 18 is even.", "Ones of 1, 3, 5, 7 or 9 means odd: 21 is odd."], "tip": "Only the ones digit decides odd or even.", "visual": {"kind": "scene", "rows": [[{"type": "counters", "n": 18, "cols": 2, "label": "18: pairs, none left over", "focus": [2]}], [{"type": "counters", "n": 21, "cols": 2, "second": 0, "label": "21: 1 left over", "focus": [3]}], [{"type": "text", "text": "Look at the ones digit", "focus": [1]}]]}},
  "4:2": {"idea": "Sort numbers into odd and even using the ones digit.", "example": "8, 25, 22, 33 → even: 8, 22; odd: 25, 33", "steps": ["Check each ones digit in turn.", "8 and 2 are even digits, so 8 and 22 are even.", "5 and 3 are odd digits, so 25 and 33 are odd."], "tip": "0 is even, so 40 is even.", "visual": {"kind": "scene", "rows": [[{"type": "chips", "items": ["8", "25", "22", "33"], "focus": [1]}], [{"type": "chips", "items": ["8", "22"], "label": "Even", "step": 2, "focus": [2]}, {"type": "chips", "items": ["25", "33"], "label": "Odd", "step": 3, "focus": [3]}]]}},
  "4:3": {"idea": "Adding odd and even numbers follows a pattern.", "example": "7 + 5 = 12 → odd + odd = even", "steps": ["7 is odd and 5 is odd.", "Each odd number has 1 left over; the two leftovers make a pair.", "So odd + odd is always even."], "tip": "Even + even = even, odd + odd = even, odd + even = odd.", "visual": {"kind": "scene", "rows": [[{"type": "counters", "n": 6, "second": 1, "cols": 7, "label": "7 is odd", "focus": [1]}, {"type": "sign", "text": "+"}, {"type": "counters", "n": 4, "second": 1, "cols": 5, "label": "5 is odd", "focus": [1]}], [{"type": "text", "text": "The 2 leftovers make a pair", "step": 2, "focus": [2]}], [{"type": "text", "text": "odd + odd = even", "big": true, "tone": "answer", "step": 3, "focus": [3]}]]}},
  "5:1": {"idea": "Jump along an empty number line in tens and ones.", "example": "21 + 15: 21 → 31 → 36", "steps": ["Start at 21.", "Jump 10 to 31.", "Jump 5 more to 36."], "tip": "Jump the tens first, then the ones.", "visual": {"kind": "scene", "rows": [[{"type": "line", "min": 20, "max": 40, "tick": 1, "labelEvery": 5, "jumps": [{"from": 21, "to": 31, "text": "+10", "step": 2}, {"from": 31, "to": 36, "text": "+5", "step": 3}], "marks": [{"value": 21, "text": "21"}, {"value": 36, "text": "36", "tone": "answer", "step": 3}], "focus": [1]}]]}},
  "5:2": {"idea": "Split both numbers into tens and ones, add each part, then combine.", "example": "22 + 31 = 20 + 30 + 2 + 1 = 53", "steps": ["Add the tens: 20 + 30 = 50.", "Add the ones: 2 + 1 = 3.", "Combine: 50 + 3 = 53."], "tip": "If the ones make more than 10, carry the extra ten into the total.", "visual": {"kind": "scene", "rows": [[{"type": "blocks", "tens": 2, "ones": 2, "label": "22", "focus": [1, 2]}, {"type": "sign", "text": "+"}, {"type": "blocks", "tens": 3, "ones": 1, "label": "31", "focus": [1, 2]}], [{"type": "text", "text": "20 + 30 = 50", "focus": [1]}, {"type": "text", "text": "2 + 1 = 3", "step": 2, "focus": [2]}], [{"type": "text", "text": "50 + 3 = 53", "big": true, "tone": "answer", "step": 3, "focus": [3]}]]}},
  "5:3": {"idea": "Change one number to a friendly number, then fix the answer.", "example": "48 + 9 = 48 + 10 − 1 = 57", "steps": ["9 is close to 10, so add 10: 48 + 10 = 58.", "You added 1 too many.", "Take 1 off: 57."], "tip": "Remember to adjust back after using the friendly number.", "visual": {"kind": "scene", "rows": [[{"type": "line", "min": 45, "max": 60, "tick": 1, "labelEvery": 5, "jumps": [{"from": 48, "to": 58, "text": "+10", "step": 1}, {"from": 58, "to": 57, "text": "−1", "step": 3}], "marks": [{"value": 48, "text": "48"}, {"value": 57, "text": "57", "tone": "answer", "step": 3}]}], [{"type": "text", "text": "1 too many", "step": 2, "focus": [2]}]]}},
  "6:1": {"idea": "Jump back along a number line in tens and ones.", "example": "65 − 14: 65 → 55 → 51", "steps": ["Start at 65.", "Jump back 10 to 55.", "Jump back 4 more to 51."], "tip": "Subtracting moves left on the number line.", "visual": {"kind": "scene", "rows": [[{"type": "line", "min": 50, "max": 70, "tick": 1, "labelEvery": 5, "jumps": [{"from": 65, "to": 55, "text": "−10", "step": 2}, {"from": 55, "to": 51, "text": "−4", "step": 3}], "marks": [{"value": 65, "text": "65"}, {"value": 51, "text": "51", "tone": "answer", "step": 3}], "focus": [1]}]]}},
  "6:2": {"idea": "Split the number you take away into tens and ones.", "example": "38 − 15 = 38 − 10 − 5 = 23", "steps": ["Take the tens: 38 − 10 = 28.", "Take the ones: 28 − 5 = 23.", "The answer is 23."], "tip": "Split only the number being taken away.", "visual": {"kind": "scene", "rows": [[{"type": "line", "min": 20, "max": 40, "tick": 1, "labelEvery": 5, "jumps": [{"from": 38, "to": 28, "text": "−10", "step": 1}, {"from": 28, "to": 23, "text": "−5", "step": 2}], "marks": [{"value": 38, "text": "38"}, {"value": 23, "text": "23", "tone": "answer", "step": 3}]}], [{"type": "text", "text": "23", "big": true, "tone": "answer", "step": 3, "focus": [3]}]]}},
  "6:3": {"idea": "Use an addition fact you know to solve a subtraction.", "example": "16 − 9: 9 + 7 = 16, so 16 − 9 = 7", "steps": ["Ask: 9 plus what makes 16?", "9 + 7 = 16.", "So 16 − 9 = 7."], "tip": "Subtraction undoes addition.", "visual": {"kind": "scene", "rows": [[{"type": "barModel", "whole": "16", "parts": ["9", "7"], "unknown": 1, "answer": "7", "answerStep": 2, "focus": [1, 2]}], [{"type": "text", "text": "16 − 9 = 7", "big": true, "tone": "answer", "step": 3, "focus": [3]}]]}},
  "7:1": {"idea": "A fact family is 3 numbers that make related + and − facts.", "example": "5, 15, 20 → 5 + 15 = 20; 20 − 15 = 5", "steps": ["The biggest number, 20, is the whole.", "The two parts, 5 and 15, add to make the whole.", "Take one part from the whole to get the other part."], "tip": "Every fact in the family uses the same 3 numbers.", "visual": {"kind": "scene", "rows": [[{"type": "barModel", "whole": "20", "parts": ["5", "15"], "focus": [1, 2]}], [{"type": "text", "text": "5 + 15 = 20", "focus": [2]}, {"type": "text", "text": "20 − 15 = 5", "step": 3, "focus": [3]}]]}},
  "7:2": {"idea": "One fact family gives 4 number sentences.", "example": "7, 5, 12 → 7 + 5 = 12, 5 + 7 = 12, 12 − 5 = 7, 12 − 7 = 5", "steps": ["Write the two addition facts: the parts can swap.", "Write the two subtraction facts: start with the whole.", "Check all 4 use 7, 5 and 12."], "tip": "Subtraction facts always start with the biggest number.", "visual": {"kind": "scene", "rows": [[{"type": "barModel", "whole": "12", "parts": ["7", "5"]}], [{"type": "chips", "items": ["7 + 5 = 12", "5 + 7 = 12"], "focus": [1, 3]}], [{"type": "chips", "items": ["12 − 5 = 7", "12 − 7 = 5"], "step": 2, "focus": [2, 3]}]]}},
  "7:3": {"idea": "Find the whole and the parts in a story, then use the fact family.", "example": "15 birds, more joined, now 28 → 28 − 15 = 13 joined", "steps": ["The whole is 28 birds; one part is 15.", "The missing part is how many joined.", "28 − 15 = 13."], "tip": "Decide which number is the whole before you calculate.", "visual": {"kind": "scene", "rows": [[{"type": "barModel", "whole": "28 birds", "parts": ["15", "13"], "unknown": 1, "answer": "13", "answerStep": 3, "focus": [1, 2]}], [{"type": "text", "text": "28 − 15 = 13", "big": true, "tone": "answer", "step": 3, "focus": [3]}]]}},
  "8:1": {"idea": "Counting by 2s connects to doubles and halves.", "example": "2, 4, 6, 8, 10, 12", "steps": ["Start at 2 and add 2 each time.", "Every number in the count is even.", "Double 6 is 12, and half of 12 is 6."], "tip": "Counting by 2s skips every second number.", "visual": {"kind": "scene", "rows": [[{"type": "line", "min": 0, "max": 12, "tick": 2, "focus": [1, 2], "jumps": [{"from": 0, "to": 2, "text": "+2"}, {"from": 2, "to": 4, "text": "+2"}, {"from": 4, "to": 6, "text": "+2"}, {"from": 6, "to": 8, "text": "+2"}, {"from": 8, "to": 10, "text": "+2"}, {"from": 10, "to": 12, "text": "+2"}]}], [{"type": "text", "text": "Double 6 is 12", "step": 3, "focus": [3]}]]}},
  "8:2": {"idea": "Counting by 5s forwards or backwards changes the number by 5 each step.", "example": "Back by 5s: 30, 25, 20, 15, 10", "steps": ["Start at 30.", "Take 5 away each step: 25, 20, 15, 10.", "The ones digit goes 0, 5, 0, 5."], "tip": "Check the direction: forwards adds, backwards takes away.", "visual": {"kind": "scene", "rows": [[{"type": "line", "min": 10, "max": 30, "tick": 5, "focus": [1], "jumps": [{"from": 30, "to": 25, "text": "−5", "step": 2}, {"from": 25, "to": 20, "text": "−5", "step": 2}, {"from": 20, "to": 15, "text": "−5", "step": 2}, {"from": 15, "to": 10, "text": "−5", "step": 2}], "marks": [{"value": 30, "text": "start"}]}], [{"type": "text", "text": "Ones digits: 0, 5, 0, 5", "step": 3, "focus": [3]}]]}},
  "8:3": {"idea": "A pattern has a start number and a rule.", "example": "Start 20, subtract 5 → 20, 15, 10, 5", "steps": ["Write the start: 20.", "Apply the rule to get each next term: 15, 10, 5.", "Check each jump is the same."], "tip": "Apply the rule to the last number, not the first.", "visual": {"kind": "scene", "rows": [[{"type": "line", "min": 0, "max": 20, "tick": 5, "focus": [1], "jumps": [{"from": 20, "to": 15, "text": "−5", "step": 2}, {"from": 15, "to": 10, "text": "−5", "step": 2}, {"from": 10, "to": 5, "text": "−5", "step": 2}], "marks": [{"value": 20, "text": "start"}]}], [{"type": "text", "text": "Every jump is 5", "step": 3, "focus": [3]}]]}},
  "9:1": {"idea": "Multiplication counts equal groups.", "example": "5 groups of 2 → 2, 4, 6, 8, 10", "steps": ["Each group has 2.", "Count by 2s once for each of the 5 groups.", "5 groups of 2 is 10."], "tip": "Say it as 'groups of': 5 × 2 means 5 groups of 2.", "visual": {"kind": "scene", "rows": [[{"type": "groups", "groups": 5, "each": 2, "focus": [1]}], [{"type": "chips", "items": ["2", "4", "6", "8", "10"], "step": 2, "focus": [2]}], [{"type": "text", "text": "10", "big": true, "tone": "answer", "step": 3, "focus": [3]}]]}},
  "9:2": {"idea": "An array shows equal groups in rows and columns.", "example": "2 rows of 5 → 2 × 5 = 10", "steps": ["Count one row: 5 dots.", "Count the rows: 2.", "2 rows of 5 makes 10."], "tip": "Turning the array round gives the same total: 5 × 2 = 10.", "visual": {"kind": "scene", "rows": [[{"type": "array", "rows": 2, "cols": 5, "focus": [1, 2]}], [{"type": "text", "text": "2 × 5 = 10", "big": true, "tone": "answer", "step": 3, "focus": [3]}]]}},
  "9:3": {"idea": "Multiplication is a quick way to write repeated addition.", "example": "3 + 3 + 3 + 3 = 4 × 3 = 12", "steps": ["Count how many times 3 is added: 4 times.", "Write it as 4 × 3.", "4 × 3 = 12."], "tip": "Only equal amounts can be written as multiplication.", "visual": {"kind": "scene", "rows": [[{"type": "groups", "groups": 4, "each": 3, "focus": [1]}], [{"type": "text", "text": "3 + 3 + 3 + 3 = 4 × 3", "step": 2, "focus": [2]}], [{"type": "text", "text": "12", "big": true, "tone": "answer", "step": 3, "focus": [3]}]]}},
  "10:1": {"idea": "Division as sharing: split a total equally into a set number of groups.", "example": "20 shared into 10 groups → 2 each", "steps": ["The total is 20 and there are 10 groups.", "Share one at a time into each group.", "Each group gets 2: 20 ÷ 10 = 2."], "tip": "Sharing tells you how many in each group.", "visual": {"kind": "scene", "rows": [[{"type": "counters", "n": 20, "cols": 10, "label": "20 counters", "focus": [1]}], [{"type": "groups", "groups": 10, "each": 2, "fillStep": 2, "focus": [2]}], [{"type": "text", "text": "20 ÷ 10 = 2", "big": true, "tone": "answer", "step": 3, "focus": [3]}]]}},
  "10:2": {"idea": "Division as grouping: make groups of a set size and count the groups.", "example": "20 in groups of 2 → 10 groups", "steps": ["The total is 20 and each group has 2.", "Count by 2s to 20: that takes 10 jumps.", "So there are 10 groups: 20 ÷ 2 = 10."], "tip": "Grouping tells you how many groups.", "visual": {"kind": "scene", "rows": [[{"type": "counters", "n": 20, "cols": 10, "label": "20 counters", "focus": [1]}], [{"type": "line", "min": 0, "max": 20, "tick": 2, "step": 2, "focus": [2], "jumps": [{"from": 0, "to": 2}, {"from": 2, "to": 4}, {"from": 4, "to": 6}, {"from": 6, "to": 8}, {"from": 8, "to": 10}, {"from": 10, "to": 12}, {"from": 12, "to": 14}, {"from": 14, "to": 16}, {"from": 16, "to": 18}, {"from": 18, "to": 20}]}], [{"type": "text", "text": "20 ÷ 2 = 10", "big": true, "tone": "answer", "step": 3, "focus": [3]}]]}},
  "10:3": {"idea": "Division undoes multiplication.", "example": "5 × 10 = 50, so 50 ÷ 5 = 10", "steps": ["Ask: how many groups of 5 make 50?", "5 × 10 = 50.", "So 50 ÷ 5 = 10."], "tip": "Use a times fact you know to check a division.", "visual": {"kind": "scene", "rows": [[{"type": "array", "rows": 10, "cols": 5, "focus": [1, 2], "label": "10 rows of 5"}], [{"type": "text", "text": "5 × 10 = 50", "step": 2, "focus": [2]}], [{"type": "text", "text": "50 ÷ 5 = 10", "big": true, "tone": "answer", "step": 3, "focus": [3]}]]}},
  "11:1": {"idea": "Add the value of each note and coin to find the total.", "example": "$20 + $5 + $2 = $27", "steps": ["Start with the largest note: $20.", "Add the next: $20 + $5 = $25.", "Add the coin: $25 + $2 = $27."], "tip": "Count the biggest values first.", "visual": {"kind": "scene", "rows": [[{"type": "money", "items": ["note-20"], "label": "$20", "focus": [1]}, {"type": "sign", "text": "+", "step": 2}, {"type": "money", "items": ["note-5"], "label": "$25", "focus": [2], "step": 2}, {"type": "sign", "text": "+", "step": 3}, {"type": "money", "items": ["coin-2"], "label": "$27", "focus": [3], "step": 3}], [{"type": "text", "text": "$27", "big": true, "tone": "answer", "step": 3, "focus": [3]}]]}},
  "11:2": {"idea": "To find a total cost, add the prices, or multiply when buying several of the same.", "example": "2 cupcakes at $3 → $3 + $3 = $6", "steps": ["One cupcake costs $3.", "Two cupcakes cost $3 twice.", "$3 + $3 = $6."], "tip": "Check whether the question buys one of each or several of one.", "visual": {"kind": "scene", "rows": [[{"type": "counters", "n": 1, "icon": "🧁", "label": "$3", "focus": [1]}, {"type": "sign", "text": "+", "step": 2}, {"type": "counters", "n": 1, "icon": "🧁", "label": "$3", "focus": [2], "step": 2}], [{"type": "text", "text": "$3 + $3 = $6", "big": true, "tone": "answer", "step": 3, "focus": [3]}]]}},
  "11:3": {"idea": "Change is the money you paid minus the price.", "example": "Pay $10 for a $6 cupcake → $4 change", "steps": ["Start at the price: $6.", "Count up to the money paid: $7, $8, $9, $10.", "That is 4 dollars, so the change is $4."], "tip": "Change is never more than the money you paid.", "visual": {"kind": "scene", "rows": [[{"type": "line", "min": 6, "max": 10, "tick": 1, "labelEvery": 1, "jumps": [{"from": 6, "to": 7, "text": "$1", "step": 2}, {"from": 7, "to": 8, "text": "$1", "step": 2}, {"from": 8, "to": 9, "text": "$1", "step": 2}, {"from": 9, "to": 10, "text": "$1", "step": 2}], "marks": [{"value": 6, "text": "price"}], "focus": [1]}], [{"type": "text", "text": "$4 change", "big": true, "tone": "answer", "step": 3, "focus": [3]}]]}},
  "12:1": {"idea": "A fraction is equal parts of a whole. 1/4 means 1 of 4 equal parts.", "example": "1 of 4 equal parts shaded → 1/4", "steps": ["Count the equal parts in the whole: 4.", "Count the shaded parts: 1.", "1 shaded out of 4 equal parts is 1/4."], "tip": "The parts must be equal in size.", "visual": {"kind": "scene", "rows": [[{"type": "fraction", "shape": "bar", "parts": 4, "shaded": 1, "shadeStep": 2, "focus": [1, 2]}], [{"type": "text", "text": "1/4", "big": true, "tone": "answer", "step": 3, "focus": [3]}]]}},
