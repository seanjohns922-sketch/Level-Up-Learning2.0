{
  "1:1": { "idea": "Each decimal place is worth one tenth of the place to its left.", "example": "4.065 = 4 + 0.06 + 0.005", "steps": ["4 is in the ones place.", "0 tenths, then 6 in the hundredths place: 0.06.", "5 in the thousandths place: 0.005."], "tip": "The 2 in 5.207 is 2 tenths, which is 0.2.", "visual": { "kind": "scene", "rows": [[{ "type": "chips", "items": ["Ones: 4", "Tenths: 0", "Hundredths: 6", "Thousandths: 5"], "focus": [1, 2, 3]}], [{ "type": "text", "text": "4 + 0.06 + 0.005", "big": true, "tone": "answer", "step": 3, "focus": [3]}]]}},
  "1:2": { "idea": "Line up the decimal points, fill gaps with zeros, then add or subtract.", "example": "10 − 3.456 = 10.000 − 3.456 = 6.544", "steps": ["Write 10 as 10.000 so both numbers have 3 decimal places.", "Subtract column by column from the right, regrouping as needed.", "The answer is 6.544. Check: 6.544 + 3.456 = 10."], "tip": "Missing places count as 0.", "visual": { "kind": "scene", "rows": [[{ "type": "column", "op": "-", "top": "10.000", "bottom": "3.456", "answer": "6.544", "answerStep": 3, "focus": [1, 2, 3]}], [{ "type": "text", "text": "Check: 6.544 + 3.456 = 10", "step": 3, "focus": [3]}]]}},
  "1:3": { "idea": "Round decimals to whole numbers to estimate and catch mistakes.", "example": "10 − 3.456 = 7.544? Estimate 10 − 3.5 = 6.5 → too big", "steps": ["Round: 3.456 is about 3.5.", "10 − 3.5 = 6.5.", "7.544 is about 1 too big, so it is wrong. The answer is 6.544."], "tip": "A wrong place-value line-up often shows up in an estimate.", "visual": { "kind": "scene", "rows": [[{ "type": "line", "min": 6, "max": 8, "tick": 0.5, "labelEvery": 1, "marks": [{ "value": 6.5, "text": "estimate 6.5", "step": 2}, { "value": 7.544, "text": "7.544?", "step": 3, "tone": "unknown" }], "focus": [1, 2, 3]}], [{ "type": "text", "text": "About 1 too big: 6.544", "big": true, "tone": "answer", "step": 3, "focus": [3]}]]}},
  "2:1": { "idea": "A prime has exactly 2 factors: 1 and itself. A composite number has more.", "example": "89 → prime; 91 = 7 × 13 → composite", "steps": ["Test small divisors: 2, 3, 5, 7.", "91 ÷ 7 = 13, so 91 is composite.", "89 has no divisor except 1 and 89, so it is prime."], "tip": "1 is neither prime nor composite.", "visual": { "kind": "scene", "rows": [[{ "type": "chips", "items": ["91 ÷ 7 = 13", "91 = 7 × 13"], "focus": [1, 2], "label": "91" }], [{ "type": "chips", "items": ["89 ÷ 2 ✗", "89 ÷ 3 ✗", "89 ÷ 5 ✗", "89 ÷ 7 ✗"], "focus": [1, 3], "label": "89" }], [{ "type": "text", "text": "89 prime, 91 composite", "big": true, "tone": "answer", "step": 3, "focus": [3]}]]}},
  "2:2": { "idea": "Factors divide a number exactly. Multiples are in its times table.", "example": "Is 9 a factor of 126? 126 ÷ 9 = 14 → yes", "steps": ["A factor must divide with no remainder.", "126 ÷ 9 = 14, a whole number.", "So 9 is a factor of 126, and 126 is a multiple of 9."], "tip": "Find factors in pairs: 1 × 36, 2 × 18, 3 × 12, 4 × 9, 6 × 6.", "visual": { "kind": "scene", "rows": [[{ "type": "chips", "items": ["9 × 10 = 90", "9 × 4 = 36", "90 + 36 = 126"], "focus": [1, 2]}], [{ "type": "text", "text": "126 ÷ 9 = 14, no remainder", "focus": [2]}], [{ "type": "text", "text": "9 is a factor of 126", "big": true, "tone": "answer", "step": 3, "focus": [3]}]]}},
  "2:3": { "idea": "A square number is a number times itself.", "example": "14² = 14 × 14 = 196; √196 = 14", "steps": ["14² means 14 × 14.", "14 × 14 = 140 + 56 = 196, so 196 is a square number.", "The square root undoes it: √196 = 14."], "tip": "Square numbers go up by odd numbers: 1, 4, 9, 16 (+3, +5, +7).", "visual": { "kind": "scene", "rows": [[{ "type": "chips", "items": ["14 × 10 = 140", "14 × 4 = 56"], "focus": [1, 2]}], [{ "type": "text", "text": "14² = 196", "big": true, "focus": [2]}], [{ "type": "text", "text": "√196 = 14", "big": true, "tone": "answer", "step": 3, "focus": [3]}]]}},
  "3:1": { "idea": "× 10, × 100, × 1000 move every digit 1, 2 or 3 places left.", "example": "0.047 × 1000 = 47", "steps": ["× 1000 moves each digit 3 places left.", "4 hundredths become 4 tens; 7 thousandths become 7 ones.", "0.047 × 1000 = 47."], "tip": "Multiplying by 10 makes a number 10 times larger, so 0.34 × 10 = 3.4, not 0.034.", "visual": { "kind": "scene", "rows": [[{ "type": "chips", "items": ["0.047", "0.47", "4.7", "47"], "arrows": true, "focus": [1, 2]}], [{ "type": "text", "text": "× 10, × 10, × 10 = × 1000", "focus": [1]}], [{ "type": "text", "text": "0.047 × 1000 = 47", "big": true, "tone": "answer", "step": 3, "focus": [3]}]]}},
  "3:2": { "idea": "÷ 10, ÷ 100, ÷ 1000 move every digit 1, 2 or 3 places right.", "example": "406 ÷ 1000 = 0.406", "steps": ["÷ 1000 moves each digit 3 places right.", "4 hundreds become 4 tenths; 6 ones become 6 thousandths.", "406 ÷ 1000 = 0.406."], "tip": "Dividing by 10 makes it 10 times smaller.", "visual": { "kind": "scene", "rows": [[{ "type": "chips", "items": ["406", "40.6", "4.06", "0.406"], "arrows": true, "focus": [1, 2]}], [{ "type": "text", "text": "÷ 10, ÷ 10, ÷ 10 = ÷ 1000", "focus": [1]}], [{ "type": "text", "text": "406 ÷ 1000 = 0.406", "big": true, "tone": "answer", "step": 3, "focus": [3]}]]}},
  "3:3": { "idea": "Work out which power of 10 changes one number into another.", "example": "109 → 1.09 is ÷ 100", "steps": ["The number got smaller, so it is a division.", "The 1 moved from hundreds to ones: 2 places right.", "2 places is ÷ 100."], "tip": "Count how many places the digits moved.", "visual": { "kind": "scene", "rows": [[{ "type": "chips", "items": ["Hundreds: 1", "Tens: 0", "Ones: 9"], "focus": [1, 2], "label": "109" }], [{ "type": "chips", "items": ["Ones: 1", "Tenths: 0", "Hundredths: 9"], "focus": [2], "label": "1.09" }], [{ "type": "text", "text": "2 places right: ÷ 100", "big": true, "tone": "answer", "step": 3, "focus": [3]}]]}},
  "4:1": { "idea": "On a number line, numbers further right are greater.", "example": "−12 < −7 < −1 < 4", "steps": ["Negative numbers are left of 0.", "−12 is further left than −7, so it is smaller.", "Any positive number is greater than any negative number."], "tip": "−2 is greater than −5, even though 5 is bigger than 2.", "visual": { "kind": "scene", "rows": [[{ "type": "line", "min": -14, "max": 6, "tick": 1, "labelEvery": 2, "marks": [{ "value": -12, "text": "-12", "step": 2}, { "value": -7, "text": "-7", "step": 2}, { "value": -1, "text": "-1" }, { "value": 4, "text": "4", "step": 3}], "focus": [1, 2, 3]}], [{ "type": "text", "text": "−12 < −7 < −1 < 4", "big": true, "tone": "answer", "step": 3, "focus": [3]}]]}},
  "4:2": { "idea": "Adding moves right on the number line; subtracting moves left.", "example": "−8 + 13 = 5", "steps": ["Start at −8.", "Adding 13 moves 13 steps right: 8 steps to 0, then 5 more.", "You land on 5."], "tip": "Crossing 0 is easier in two jumps: to 0, then past it.", "visual": { "kind": "scene", "rows": [[{ "type": "line", "min": -10, "max": 6, "tick": 1, "labelEvery": 2, "jumps": [{ "from": -8, "to": 0, "text": "+8", "step": 2}, { "from": 0, "to": 5, "text": "+5", "step": 2}], "marks": [{ "value": -8, "text": "start" }, { "value": 5, "text": "5", "step": 3, "tone": "answer" }], "focus": [1, 2, 3]}], [{ "type": "text", "text": "−8 + 13 = 5", "big": true, "tone": "answer", "step": 3, "focus": [3]}]]}},
  "4:3": { "idea": "A change between integers is the distance moved and its direction.", "example": "$15 → −$9: down $24, so $24 was spent", "steps": ["From 15 down to 0 is 15.", "From 0 down to −9 is 9 more.", "15 + 9 = 24 down, so $24 was spent."], "tip": "Up means an increase; down means a decrease.", "visual": { "kind": "scene", "rows": [[{ "type": "line", "min": -10, "max": 16, "tick": 1, "labelEvery": 5, "jumps": [{ "from": 15, "to": 0, "text": "−15", "step": 1}, { "from": 0, "to": -9, "text": "−9", "step": 2}], "marks": [{ "value": 15, "text": "$15" }, { "value": -9, "text": "−$9", "step": 2}], "focus": [1, 2]}], [{ "type": "text", "text": "15 + 9 = $24 spent", "big": true, "tone": "answer", "step": 3, "focus": [3]}]]}},
  "5:1": { "idea": "Simplify by dividing the top and bottom by a common factor.", "example": "18/24 = 3/4 (÷ 6)", "steps": ["Find the highest common factor of 18 and 24: 6.", "18 ÷ 6 = 3 and 24 ÷ 6 = 4.", "So 18/24 = 3/4."], "tip": "To build equivalent fractions, multiply instead: 7/8 = 14/16.", "visual": { "kind": "scene", "rows": [[{ "type": "fraction", "shape": "bar", "parts": 24, "shaded": 18, "label": "18/24", "focus": [1, 2]}], [{ "type": "sign", "text": "=" }, { "type": "fraction", "shape": "bar", "parts": 4, "shaded": 3, "label": "3/4", "focus": [2, 3]}], [{ "type": "text", "text": "18/24 = 3/4 (÷ 6)", "big": true, "tone": "answer", "step": 3, "focus": [3]}]]}},
  "5:2": { "idea": "Order fractions with a common denominator or a benchmark like 1/2.", "example": "3/5 vs 7/12: 3/5 = 0.6 and 7/12 ≈ 0.58 → 7/12 < 3/5", "steps": ["Both are a little more than 1/2.", "Compare how far past 1/2: 3/5 is 1/10 more, 7/12 is 1/12 more.", "1/10 > 1/12, so 3/5 is larger."], "tip": "Fractions close to 1 have a top number close to the bottom number.", "visual": { "kind": "scene", "rows": [[{ "type": "fraction", "shape": "bar", "parts": 5, "shaded": 3, "label": "3/5", "focus": [1, 2]}], [{ "type": "fraction", "shape": "bar", "parts": 12, "shaded": 7, "label": "7/12", "focus": [1, 2]}], [{ "type": "text", "text": "3/5 is larger", "big": true, "tone": "answer", "step": 3, "focus": [3]}]]}},
  "5:3": { "idea": "Mixed numbers and improper fractions show the same amount.", "example": "3 3/8 = 27/8", "steps": ["3 wholes are 24 eighths.", "24/8 + 3/8 = 27/8.", "So 3 3/8 and 27/8 are equal."], "tip": "Whole × denominator + numerator gives the improper numerator.", "visual": { "kind": "scene", "rows": [[{ "type": "fraction", "shape": "bar", "parts": 8, "shaded": 8, "label": "8/8" }, { "type": "fraction", "shape": "bar", "parts": 8, "shaded": 8, "label": "8/8" }], [{ "type": "fraction", "shape": "bar", "parts": 8, "shaded": 8, "label": "8/8" }, { "type": "fraction", "shape": "bar", "parts": 8, "shaded": 3, "label": "3/8" }], [{ "type": "text", "text": "24/8 + 3/8", "focus": [1, 2]}], [{ "type": "text", "text": "3 3/8 = 27/8", "big": true, "tone": "answer", "step": 3, "focus": [3]}]]}},
  "6:1": { "idea": "The best common denominator is the lowest common multiple.", "example": "3/8 and 5/12 → LCM 24", "steps": ["List multiples of 12: 12, 24, 36.", "Find the first one 8 also divides: 24.", "Use 24 as the denominator."], "tip": "Multiplying the denominators always works, but it may not be the smallest.", "visual": { "kind": "scene", "rows": [[{ "type": "chips", "items": ["12", "24", "36"], "focus": [1, 2], "label": "Multiples of 12" }], [{ "type": "text", "text": "24 ÷ 8 = 3 ✓", "focus": [2]}], [{ "type": "text", "text": "Denominator 24", "big": true, "tone": "answer", "step": 3, "focus": [3]}]]}},
  "6:2": { "idea": "Rename with a common denominator, then add or subtract, then simplify.", "example": "5/6 + 1/4 = 10/12 + 3/12 = 13/12 = 1 1/12", "steps": ["The LCM of 6 and 4 is 12.", "5/6 = 10/12 and 1/4 = 3/12.", "10/12 + 3/12 = 13/12 = 1 1/12."], "tip": "Denominators must match because parts must be the same size.", "visual": { "kind": "scene", "rows": [[{ "type": "fraction", "shape": "bar", "parts": 12, "shaded": 10, "label": "5/6 = 10/12", "focus": [2]}, { "type": "fraction", "shape": "bar", "parts": 12, "shaded": 3, "label": "1/4 = 3/12", "focus": [2]}], [{ "type": "text", "text": "10/12 + 3/12 = 13/12", "focus": [3]}], [{ "type": "text", "text": "1 1/12", "big": true, "tone": "answer", "step": 3, "focus": [3]}]]}},
  "6:3": { "idea": "Estimate fraction answers to see if they make sense.", "example": "3/4 + 5/6 ≈ 1 + 1 = 2 → 19/12 is about 1 1/2, reasonable", "steps": ["Round each fraction to 0, 1/2 or 1: both are close to 1.", "So the sum should be a bit less than 2.", "19/12 = 1 7/12, which fits."], "tip": "Adding two fractions less than 1 always gives less than 2.", "visual": { "kind": "scene", "rows": [[{ "type": "fraction", "shape": "bar", "parts": 4, "shaded": 3, "label": "3/4 ≈ 1", "focus": [1]}, { "type": "fraction", "shape": "bar", "parts": 6, "shaded": 5, "label": "5/6 ≈ 1", "focus": [1]}], [{ "type": "text", "text": "Estimate: a bit less than 2", "focus": [2]}], [{ "type": "text", "text": "19/12 = 1 7/12 fits", "big": true, "tone": "answer", "step": 3, "focus": [3]}]]}},
  "7:1": { "idea": "To find a fraction of an amount, divide by the denominator and multiply by the numerator.", "example": "3/8 of 96 = 96 ÷ 8 × 3 = 36", "steps": ["Find one eighth: 96 ÷ 8 = 12.", "Three eighths is 3 of those: 12 × 3.", "3/8 of 96 = 36."], "tip": "If 2/5 of a number is 18, one fifth is 9 and the whole is 45.", "visual": { "kind": "scene", "rows": [[{ "type": "barModel", "whole": "96", "parts": ["12", "12", "12", "12", "12", "12", "12", "12"], "focus": [1, 2]}], [{ "type": "text", "text": "3 of the 8 parts: 12 × 3", "focus": [2]}], [{ "type": "text", "text": "3/8 of 96 = 36", "big": true, "tone": "answer", "step": 3, "focus": [3]}]]}},
  "7:2": { "idea": "Find percentages using 10%, 50% and other easy parts.", "example": "35% of 48 = 30% + 5% = 14.4 + 2.4 = 16.8", "steps": ["10% of 48 is 4.8, so 30% is 14.4.", "5% is half of 10%: 2.4.", "14.4 + 2.4 = 16.8."], "tip": "If 12% is 9, then 1% is 0.75 and 100% is 75.", "visual": { "kind": "scene", "rows": [[{ "type": "chips", "items": ["10%: 4.8", "30%: 14.4", "5%: 2.4"], "focus": [1, 2]}], [{ "type": "text", "text": "14.4 + 2.4 = 16.8", "big": true, "tone": "answer", "step": 3, "focus": [3]}]]}},
  "7:3": { "idea": "Choose the form that makes the calculation easiest.", "example": "75% of 180 = 3/4 of 180 = 135", "steps": ["75% is the same as 3/4.", "One quarter of 180 is 45.", "Three quarters is 3 × 45 = 135."], "tip": "5% is half of 10%. 25% is a quarter.", "visual": { "kind": "scene", "rows": [[{ "type": "barModel", "whole": "180", "parts": ["45", "45", "45", "45"], "focus": [1, 2]}], [{ "type": "text", "text": "75% = 3/4", "focus": [1]}], [{ "type": "text", "text": "3 × 45 = 135", "big": true, "tone": "answer", "step": 3, "focus": [3]}]]}},
  "8:1": { "idea": "A discount is a percentage taken off the price.", "example": "15% off $80 → $80 − $12 = $68", "steps": ["Find the discount: 10% is $8 and 5% is $4, so 15% is $12.", "Take it off: $80 − $12 = $68.", "Two discounts apply one after the other, to the new price each time."], "tip": "Compare deals by the money saved or the final price, not just the percentage.", "visual": { "kind": "scene", "rows": [[{ "type": "barModel", "whole": "$80", "parts": ["$12", "$68"], "unknown": 1, "answer": "$68", "answerStep": 2, "focus": [1, 2]}], [{ "type": "chips", "items": ["10%: $8", "5%: $4", "15%: $12"], "focus": [1]}], [{ "type": "text", "text": "A second discount uses the new price", "step": 3, "focus": [3]}]]}},
  "8:2": { "idea": "A unit rate is the price for one unit. Use it to find the best buy.", "example": "6 pens for $13.50 → $2.25 per pen", "steps": ["Divide the price by the number of items: $13.50 ÷ 6.", "Each pen costs $2.25.", "Compare unit prices: the lower one is better value."], "tip": "A bigger pack is not always better value.", "visual": { "kind": "scene", "rows": [[{ "type": "barModel", "whole": "$13.50", "parts": ["$2.25", "$2.25", "$2.25", "$2.25", "$2.25", "$2.25"], "focus": [1, 2]}], [{ "type": "text", "text": "$2.25 per pen", "big": true, "tone": "answer", "step": 2, "focus": [2]}], [{ "type": "text", "text": "Lower unit price = better value", "step": 3, "focus": [3]}]]}},
  "8:3": { "idea": "Explain a decision using fair comparisons.", "example": "$54 for 6 kg vs $72 for 9 kg → $9/kg vs $8/kg", "steps": ["Work out the unit price of each: $54 ÷ 6 = $9 and $72 ÷ 9 = $8.", "Compare the same unit: $8 per kg is cheaper.", "So the $72 pack is better value, even though it costs more in total."], "tip": "A cheaper total does not always mean better value.", "visual": { "kind": "scene", "rows": [[{ "type": "chips", "items": ["$54 ÷ 6 = $9 per kg", "$72 ÷ 9 = $8 per kg"], "focus": [1, 2]}], [{ "type": "text", "text": "The $72 pack is better value", "big": true, "tone": "answer", "step": 3, "focus": [3]}]]}},
  "9:1": { "idea": "Compare fractions and decimals by changing them to one form.", "example": "5/8 vs 0.6 → 0.625 > 0.6", "steps": ["Change 5/8 to a decimal: 5 ÷ 8 = 0.625.", "Compare: 0.625 > 0.600.", "So 5/8 is larger."], "tip": "Closest to 1 means the smallest gap to 1: 11/12 is 1/12 away.", "visual": { "kind": "scene", "rows": [[{ "type": "fraction", "shape": "bar", "parts": 8, "shaded": 5, "label": "5/8 = 0.625", "focus": [1, 2]}], [{ "type": "fraction", "shape": "bar", "parts": 10, "shaded": 6, "label": "0.6", "focus": [2]}], [{ "type": "text", "text": "5/8 is larger", "big": true, "tone": "answer", "step": 3, "focus": [3]}]]}},
  "9:2": { "idea": "Find part of a quantity, or the whole from a part.", "example": "40% full is 36 L → 10% is 9 L → full is 90 L", "steps": ["40% is 36 L, so 10% is 36 ÷ 4 = 9 L.", "100% is 10 × 9 L.", "The full tank is 90 L."], "tip": "Find 1% or 10% first, then scale.", "visual": { "kind": "scene", "rows": [[{ "type": "barModel", "whole": "90 L", "parts": ["9", "9", "9", "9", "9", "9", "9", "9", "9", "9"], "focus": [1, 2]}], [{ "type": "text", "text": "40% = 36 L, so 10% = 9 L", "focus": [1]}], [{ "type": "text", "text": "Full tank: 90 L", "big": true, "tone": "answer", "step": 3, "focus": [3]}]]}},
  "9:3": { "idea": "Round decimals to estimate and check calculations.", "example": "7.82 − 3.47 ≈ 8 − 3.5 = 4.5 → about 4", "steps": ["Round each number to an easy value.", "Calculate the estimate.", "Compare it with the exact answer: 4.35 is close."], "tip": "A good estimate catches decimal-point mistakes.", "visual": { "kind": "scene", "rows": [[{ "type": "chips", "items": ["7.82 ≈ 8", "3.47 ≈ 3.5"], "focus": [1]}], [{ "type": "text", "text": "8 − 3.5 = 4.5", "focus": [2]}], [{ "type": "text", "text": "4.35 is close", "big": true, "tone": "answer", "step": 3, "focus": [3]}]]}},
  "10:1": { "idea": "Order integers by their position on the number line.", "example": "−15, −6, 0, 8", "steps": ["Negatives are left of 0: −15 is left of −6.", "0 comes next.", "Positive numbers are on the right: 8."], "tip": "The integer between −4 and −2 is −3.", "visual": { "kind": "scene", "rows": [[{ "type": "line", "min": -16, "max": 10, "tick": 1, "labelEvery": 4, "marks": [{ "value": -15, "text": "-15", "step": 1}, { "value": -6, "text": "-6", "step": 1}, { "value": 0, "text": "0", "step": 2}, { "value": 8, "text": "8", "step": 3}], "focus": [1, 2, 3]}], [{ "type": "text", "text": "−15, −6, 0, 8", "big": true, "tone": "answer", "step": 3, "focus": [3]}]]}},
  "10:2": { "idea": "Use integers to describe real changes.", "example": "Score −35, gain 50 → −35 + 50 = 15", "steps": ["Start at −35.", "Gaining 50 moves 50 right: 35 to reach 0, then 15 more.", "The new score is 15."], "tip": "Owing money is a negative balance.", "visual": { "kind": "scene", "rows": [[{ "type": "line", "min": -40, "max": 20, "tick": 5, "labelEvery": 10, "jumps": [{ "from": -35, "to": 0, "text": "+35", "step": 2}, { "from": 0, "to": 15, "text": "+15", "step": 2}], "marks": [{ "value": -35, "text": "start" }, { "value": 15, "text": "15", "step": 3, "tone": "answer" }], "focus": [1, 2, 3]}], [{ "type": "text", "text": "Score: 15", "big": true, "tone": "answer", "step": 3, "focus": [3]}]]}},
  "10:3": { "idea": "A coordinate (x, y) goes across first, then up or down.", "example": "(−4, 3): left 4, up 3", "steps": ["Start at the origin (0, 0).", "x = −4: move 4 left.", "y = 3: move 3 up. That is the point."], "tip": "Quadrant I is (+, +), top right. Count anticlockwise for II, III and IV.", "visual": { "kind": "scene", "rows": [[{ "type": "visual", "visual": { "kind": "grid", "min": -5, "max": 5, "points": [{ "x": -4, "y": 3, "label": "(−4, 3)" }]}, "focus": [1, 2, 3]}], [{ "type": "text", "text": "4 left, then 3 up", "focus": [2, 3]}]]}},
  "11:1": { "idea": "Successive discounts apply to the new price each time.", "example": "$84, 10% off then 25% off → $75.60 → $56.70", "steps": ["10% off $84: $84 − $8.40 = $75.60.", "25% off $75.60: $75.60 − $18.90 = $56.70.", "This is not the same as 35% off."], "tip": "Work out each discount on the price at that step.", "visual": { "kind": "scene", "rows": [[{ "type": "chips", "items": ["$84", "$75.60", "$56.70"], "arrows": true, "focus": [1, 2]}], [{ "type": "text", "text": "10% off, then 25% off", "focus": [1, 2]}], [{ "type": "text", "text": "Not the same as 35% off", "big": true, "tone": "answer", "step": 3, "focus": [3]}]]}},
  "11:2": { "idea": "Divide the price by the quantity to get the cost per unit.", "example": "$8.40 for 3 kg → $2.80 per kg", "steps": ["Unit price = price ÷ quantity.", "$8.40 ÷ 3 = $2.80.", "It costs $2.80 per kg."], "tip": "Compare unit prices in the same unit: per kg with per kg.", "visual": { "kind": "scene", "rows": [[{ "type": "barModel", "whole": "$8.40", "parts": ["$2.80", "$2.80", "$2.80"], "focus": [1, 2]}], [{ "type": "text", "text": "$2.80 per kg", "big": true, "tone": "answer", "step": 3, "focus": [3]}]]}},
  "11:3": { "idea": "Justify a money decision with a fair, same-unit comparison.", "example": "2 L for $3.60 vs 3 L for $5.40 → both $1.80 per L → equal value", "steps": ["Find the unit price of each option.", "Compare them using the same unit.", "State the decision and the reason: the lower unit price, or 'equal' if they match."], "tip": "Mention the unit in your reason, such as 'per litre'.", "visual": { "kind": "scene", "rows": [[{ "type": "chips", "items": ["$3.60 ÷ 2 = $1.80 per L", "$5.40 ÷ 3 = $1.80 per L"], "focus": [1, 2]}], [{ "type": "text", "text": "Same unit price: equal value", "big": true, "tone": "answer", "step": 3, "focus": [3]}]]}},
