 "2:2": {
  "idea": "An event and its complement add up to 1.",
  "example": "P(red) = 3/8, so P(not red) = 5/8",
  "steps": [
   "Find the probability you know.",
   "Subtract it from 1.",
   "3/8 + 5/8 = 8/8 = 1."
  ],
  "tip": "'Not' means the complement.",
