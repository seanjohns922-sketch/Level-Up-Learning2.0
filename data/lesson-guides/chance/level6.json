 "3:1": {
  "idea": "Expected frequency = probability × number of trials.",
  "example": "P = 3/8, 120 trials → 3/8 × 120 = 45",
  "steps": [
   "Write the probability: 3/8.",
   "Multiply by the number of trials: 3/8 × 120.",
   "That is the expected count: 45."
  ],
  "tip": "Expect about this many, not exactly.",
