{
 "1:1": {
  "idea": "Some shapes have straight sides; some have curved edges.",
  "example": "Circle → curved; triangle → straight sides",
  "steps": [
   "Trace around the edge with your finger.",
   "If it bends all the way round, it is curved.",
   "If it has straight lines and corners, it has straight sides."
  ],
  "tip": "An oval is curved, like a circle.",
