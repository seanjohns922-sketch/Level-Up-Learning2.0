  "example": "Curved: circle, oval. Straight: square, triangle",
  "steps": [
   "Look at each shape's edges.",
   "Sort curved from straight.",
   "Pick the shape that matches the question."
  ],
  "tip": "Corners only appear on straight-sided shapes.",
