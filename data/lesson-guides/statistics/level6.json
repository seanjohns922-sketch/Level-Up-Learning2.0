 "1:1": {
  "idea": "Continuous data is measured, so it can take any value in a range.",
  "example": "Length between 6.2 and 6.4 cm → 6.3 cm",
  "steps": [
   "Check that the data is measured, not counted.",
   "Any value between two measurements is possible.",
   "Use the same unit and precision when recording."
  ],
  "tip": "Height, mass and time are continuous; number of pets is not.",
