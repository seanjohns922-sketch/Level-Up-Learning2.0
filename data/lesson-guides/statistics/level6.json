 "5:1": {
  "idea": "A broken axis can make small differences look big.",
  "example": "98 and 100 on an axis starting at 97 → bar looks 3× taller",
  "steps": [
   "Check where the vertical axis starts.",
   "Read the actual values.",
   "Calculate the real difference: 100 − 98 = 2."
  ],
  "tip": "Always read the numbers, not just the bar heights.",
