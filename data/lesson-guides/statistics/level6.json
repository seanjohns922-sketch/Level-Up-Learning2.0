 },
 "1:3": {
  "idea": "Only compare data sets that measure the same thing in the same way.",
  "example": "Class A minutes vs Class B minutes → fair; minutes vs hours → not fair",
  "steps": [
   "Check both sets measure the same variable.",
   "Check the units and method match.",
   "Then compare peaks and spread."
  ],
  "tip": "Convert units before comparing.",
