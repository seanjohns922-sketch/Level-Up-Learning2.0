 "1:2": {
  "idea": "Counting gives whole numbers; measuring gives values on a scale.",
  "example": "Number of books → count; height → measure",
  "steps": [
   "Ask: am I counting or measuring?",
   "Counting gives discrete data.",
   "Measuring gives continuous data with units."
  ],
  "tip": "Measured data needs the same unit for every entry.",
