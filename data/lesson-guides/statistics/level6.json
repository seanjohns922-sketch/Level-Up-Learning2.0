 "3:3": {
  "idea": "Draw conclusions that the comparison supports.",
  "example": "Laps: A range 3, B range 8 → 'B's results vary more.'",
  "steps": [
   "Compare the groups' features.",
   "State what is different.",
   "Only claim what the data shows."
  ],
  "tip": "Small samples can't prove a general rule.",
