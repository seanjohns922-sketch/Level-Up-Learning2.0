 },
 "2:1": {
  "idea": "The mode is the most common value in a data set.",
  "example": "Goals: 2, 4, 3, 4, 1, 4, 2 → mode 4",
  "steps": [
   "Count each value.",
   "Find the highest count.",
   "That value is the mode."
  ],
  "tip": "The mode can be read as the tallest bar.",
  "visual": {
   "kind": "dots",
   "title": "Goals scored",
   "min": 0,
   "max": 5,
   "values": [
    2,
    4,
    3,
    4,
    1,
    4,
    2
   ]
  }
 },
 "2:2": {
  "idea": "The range is the highest value minus the lowest.",
  "example": "12, 7, 19, 4, 15 → 19 − 4 = 15",
  "steps": [
   "Find the highest value: 19.",
   "Find the lowest value: 4.",
   "Subtract: 19 − 4 = 15."
  ],
  "tip": "The range measures spread, not the middle.",
  "visual": {
   "kind": "dots",
   "title": "Data",
   "min": 0,
   "max": 20,
   "values": [
    12,
    7,
    19,
    4,
    15
   ]
  }
 },
 "2:3": {
  "idea": "Describe the shape: peak, spread and any unusual values.",
  "example": "Teeth lost: most at 1–2, one at 6 → peaks low, one outlier",
  "steps": [
   "Find the peak.",
   "Find the range of the data.",
   "Note any values far from the rest."
  ],
  "tip": "An outlier makes the range much bigger.",
