 },
 "4:2": {
  "idea": "Check the evidence: who was asked, how many and how.",
  "example": "20 people at a gym say 'everyone exercises' → biased sample",
  "steps": [
   "Look at the sample size.",
   "Look at who was asked.",
   "Decide if the sample represents everyone."
  ],
  "tip": "A small or one-sided sample gives weak evidence.",
  "visual": {
   "kind": "scene",
