 },
 "4:3": {
  "idea": "A conclusion must stay within what the data shows.",
  "example": "Survey of one class → conclusion about that class only",
  "steps": [
   "Identify who the data came from.",
   "Check the claim only covers that group.",
   "Prefer conclusions that state their limits."
  ],
  "tip": "Don't stretch a small survey into a claim about everyone.",
