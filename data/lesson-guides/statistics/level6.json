 "4:1": {
  "idea": "Check a media claim by calculating the real share.",
  "example": "Sport 54 of 180 → 54 ÷ 180 = 30%",
  "steps": [
   "Find the count and the total.",
   "Divide the count by the total.",
   "Multiply by 100 for a percentage."
  ],
  "tip": "A share needs the total, not just the count.",
